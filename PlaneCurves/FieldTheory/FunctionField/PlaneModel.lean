/-!
# Plane models of function fields of one variable

Let `K` be generated over a field `k` by an element `x` transcendental over `k` and an element
`y` algebraic over `k(x)`. Clearing the denominators of the minimal polynomial of `y` over
`k(x)` gives a primitive polynomial `F ∈ k[X][Y]`, irreducible in `k[X, Y]` by Gauss's lemma, of
degree `[K : k(x)]` in `Y`, and the relations between `x` and `y` are exactly the multiples of
`F`. Hence `K` is the function field `k(F)` of the affine plane curve `F = 0`.

Every function field of one variable over a perfect field is of this form, since it is
generated by two elements `x` and `y` with `K / k(x)` separable: every curve is birational to an
affine plane curve.

## Main definitions

* `PlaneCurves.fractionRingAlgEquivOfKerAevalEq`: if `K = k(x, y)` and the relations between
  `x` and `y` are the multiples of `F`, the isomorphism `k(F) ≃ₐ[k] K`.

## Main results

* `PlaneCurves.exists_irreducible_ker_aeval_eq_span_singleton`: for `K = k(x, y)` with `x`
  transcendental and `K / k(x)` finite, the relations between `x` and `y` are the multiples of
  an irreducible `F` of degree `[K : k(x)]` in `Y`.
* `TauCeti.IsFunctionField.exists_ker_aeval_eq_span_singleton_of_isSeparable`: for a separating
  `x`, there are `y` and an irreducible `F` with `K = k(x, y)`, relations `(F)` and
  `deg_Y F = [K : k(x)]`.
* `TauCeti.IsFunctionField.exists_ker_aeval_eq_span_singleton_of_perfectField`: over a perfect
  field, every function field of one variable is `k(F)` for an irreducible plane `F`.

## References

* [W. Fulton, *Algebraic Curves: An Introduction to Algebraic Geometry*][Fulton2008],
  §6.6, Corollary to Proposition 12, and Appendix A
-/

public section

open MvPolynomial IntermediateField Polynomial.Bivariate
open scoped IntermediateField

namespace PlaneCurves

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- The degree of `K` over `k(x)`, for `x` transcendental over `k`, is its degree over `k(X)`,
with `X` acting as `x`. -/
private theorem finrank_ratFunc_eq {x : K} (hx : Transcendental k x) :
    letI := TauCeti.ratFuncAlgebraOfTranscendental hx
    Module.finrank (RatFunc k) K = Module.finrank k⟮x⟯ K := by
  let _ := TauCeti.ratFuncAlgebraOfTranscendental hx
  refine Algebra.finrank_eq_of_equiv_equiv (RatFunc.algEquivOfTranscendental x hx).toRingEquiv
    (RingEquiv.refl K) (RingHom.ext fun r ↦ ?_)
  simp [TauCeti.algebraMap_ratFuncAlgebraOfTranscendental_apply]

/-- **The plane equation of a pair of generators.** Let `K = k(x, y)` with `x` transcendental
over `k` and `K` finite over `k(x)`. Then there is an irreducible `F ∈ k[X, Y]` of degree
`[K : k(x)]` in `Y` such that the polynomials vanishing at `(x, y)` are exactly the multiples of
`F`. -/
theorem exists_irreducible_ker_aeval_eq_span_singleton {x y : K} (hx : Transcendental k x)
    (hgen : k⟮x, y⟯ = ⊤) [FiniteDimensional k⟮x⟯ K] :
    ∃ F : MvPolynomial (Fin 2) k, Irreducible F ∧
      RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F} ∧
      F.degreeOf 1 = Module.finrank k⟮x⟯ K := by
  let _ := TauCeti.ratFuncAlgebraOfTranscendental hx
  have := TauCeti.isScalarTower_ratFuncAlgebraOfTranscendental hx
  have := TauCeti.finiteDimensional_ratFuncAlgebraOfTranscendental hx
  -- `y` generates `K` over `k(X)`, so `[K : k(x)]` is the degree of its minimal polynomial `G`.
  have htop : (RatFunc k)⟮y⟯ = ⊤ :=
    TauCeti.adjoin_eq_top_ratFunc_of_adjoin_pair_eq_top hx (by rwa [Set.pair_comm])
  have hint : IsIntegral (RatFunc k) y := Algebra.IsIntegral.isIntegral y
  set G := minpoly (RatFunc k) y
  have hdeg : G.natDegree = Module.finrank k⟮x⟯ K := by
    rw [← finrank_ratFunc_eq hx, ← finrank_top', ← htop, adjoin.finrank hint]
  -- Clear the denominators of `G` and take the primitive part `q ∈ k[X][Y]`: its image in
  -- `k(X)[Y]` is a nonzero multiple of `G`.
  set p := IsLocalization.integerNormalization (nonZeroDivisors (Polynomial k)) G
  let _ : NormalizedGCDMonoid (Polynomial k) := Classical.arbitrary _
  set q := p.primPart
  obtain ⟨b, hb, hpb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (Polynomial k)) G
  have hp : p ≠ 0 :=
    IsFractionRing.integerNormalization_eq_zero_iff.not.mpr (minpoly.ne_zero hint)
  have hinj := IsFractionRing.injective (Polynomial k) (RatFunc k)
  have hc : algebraMap (Polynomial k) (RatFunc k) p.content ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (Polynomial.content_eq_zero_iff.not.mpr hp)
  have hb' : algebraMap (Polynomial k) (RatFunc k) b ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (nonZeroDivisors.ne_zero hb)
  have hq : q.map (algebraMap (Polynomial k) (RatFunc k)) =
      Polynomial.C ((algebraMap (Polynomial k) (RatFunc k) p.content)⁻¹ *
        algebraMap (Polynomial k) (RatFunc k) b) * G := by
    have h : p.map (algebraMap (Polynomial k) (RatFunc k)) = b • G := hpb
    rw [p.eq_C_content_mul_primPart, Polynomial.map_mul, Polynomial.map_C,
      Algebra.smul_def, Polynomial.algebraMap_apply] at h
    rw [map_mul, mul_assoc, ← h, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul]
  have hassoc : Associated G (q.map (algebraMap (Polynomial k) (RatFunc k))) := by
    rw [hq]
    exact (associated_unit_mul_left G _
      (Polynomial.isUnit_C.mpr (by simpa using And.intro hc hb'))).symm
  have hirr : Irreducible q :=
    (Polynomial.isPrimitive_primPart p).irreducible_iff_irreducible_map_fraction_map.mpr
      (hassoc.irreducible (minpoly.irreducible hint))
  -- Read `q` as a polynomial `F` in two variables.
  refine ⟨equivMvPolynomial k q, (MulEquiv.irreducible_iff _).mpr hirr, ?_, ?_⟩
  · refine TauCeti.ker_aeval_eq_span_singleton_of_irreducible
      ((MulEquiv.irreducible_iff _).mpr hirr) hx ?_
    have h := aeval_map_eq_aeval_equivMvPolynomial (K := RatFunc k) q y
    rw [RatFunc.algebraMap_X, TauCeti.algebraMap_ratFuncAlgebraOfTranscendental_X, hq,
      Polynomial.aeval_mul, minpoly.aeval, mul_zero] at h
    exact h.symm
  · rw [degreeOf_one_equivMvPolynomial, show q.natDegree = p.natDegree from p.natDegree_primPart,
      ← hdeg, ← Polynomial.natDegree_map_eq_of_injective hinj, hpb, Algebra.smul_def,
      Polynomial.algebraMap_apply, Polynomial.natDegree_C_mul hb']

section FractionRing

variable {x y : K} {F : MvPolynomial (Fin 2) k}

/-- The embedding `k[X, Y] / (F) → K`, `X ↦ x`, `Y ↦ y`, when the relations between `x` and `y`
are the multiples of `F`. -/
private noncomputable def quotientAlgHom
    (hker : RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F}) :
    (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) →ₐ[k] K :=
  Ideal.Quotient.liftₐ _ (aeval ![x, y]) fun a ha ↦ by
    rwa [← hker, RingHom.mem_ker] at ha

private theorem quotientAlgHom_injective
    (hker : RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F}) :
    Function.Injective (quotientAlgHom hker) := by
  refine (injective_iff_map_eq_zero _).mpr fun a ha ↦ ?_
  obtain ⟨φ, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [Ideal.Quotient.eq_zero_iff_mem, ← hker, RingHom.mem_ker]
  exact ha

/-- With the structure given by `X ↦ x`, `Y ↦ y`, the field `K = k(x, y)` is a field of
fractions of `k[X, Y] / (F)`, when the relations between `x` and `y` are the multiples of `F`. -/
private theorem isFractionRing_quotient (hgen : k⟮x, y⟯ = ⊤)
    (hker : RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F}) :
    letI := (quotientAlgHom hker).toRingHom.toAlgebra
    IsFractionRing (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K := by
  let _ := (quotientAlgHom hker).toRingHom.toAlgebra
  have : FaithfulSMul (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (quotientAlgHom_injective hker)
  refine .of_field _ _ fun z ↦ ?_
  obtain ⟨r, hr, s, hs, rfl⟩ :=
    mem_adjoin_iff_div.mp (hgen ▸ IntermediateField.mem_top : z ∈ k⟮x, y⟯)
  have hrange : (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K).range =
      Algebra.adjoin k {x, y} := by
    rw [← Algebra.adjoin_range_eq_range_aeval, Matrix.range_cons_cons_empty]
  rw [← hrange] at hr hs
  obtain ⟨φ, rfl⟩ := hr
  obtain ⟨ψ, rfl⟩ := hs
  exact ⟨Ideal.Quotient.mk _ φ, Ideal.Quotient.mk _ ψ, rfl⟩

/-- **The function field of a plane model.** If `K = k(x, y)` and the polynomials vanishing at
`(x, y)` are the multiples of `F`, then `X ↦ x`, `Y ↦ y` induces an isomorphism from the
function field `k(F)`, the field of fractions of `k[X, Y] / (F)`, onto `K`. -/
noncomputable def fractionRingAlgEquivOfKerAevalEq (hgen : k⟮x, y⟯ = ⊤)
    (hker : RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F}) :
    FractionRing (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) ≃ₐ[k] K :=
  letI := (quotientAlgHom hker).toRingHom.toAlgebra
  haveI : IsScalarTower k (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K :=
    .of_algebraMap_eq fun c ↦ ((quotientAlgHom hker).commutes c).symm
  haveI := isFractionRing_quotient hgen hker
  (FractionRing.algEquiv (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K).restrictScalars k

/-- The isomorphism `k(F) ≃ₐ[k] K` sends the class of `φ ∈ k[X, Y]` to `φ(x, y)`. -/
@[simp]
theorem fractionRingAlgEquivOfKerAevalEq_algebraMap_mk (hgen : k⟮x, y⟯ = ⊤)
    (hker : RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F})
    (φ : MvPolynomial (Fin 2) k) :
    fractionRingAlgEquivOfKerAevalEq hgen hker
        (algebraMap _ _ (Ideal.Quotient.mk (Ideal.span {F}) φ)) =
      aeval ![x, y] φ := by
  let _ := (quotientAlgHom hker).toRingHom.toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K :=
    .of_algebraMap_eq fun c ↦ ((quotientAlgHom hker).commutes c).symm
  have := isFractionRing_quotient hgen hker
  exact (FractionRing.algEquiv (MvPolynomial (Fin 2) k ⧸ Ideal.span {F}) K).commutes _

end FractionRing

end PlaneCurves

namespace TauCeti.IsFunctionField

open PlaneCurves

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- **A plane model with a given separating element.** Let `K` be a function field of one
variable over `k` and `x ∈ K` with `K / k(x)` separable. Then there are `y ∈ K` and an
irreducible `F ∈ k[X, Y]` with `K = k(x, y)`, such that the polynomials vanishing at `(x, y)`
are exactly the multiples of `F`, and `F` has degree `[K : k(x)]` in `Y`. -/
theorem exists_ker_aeval_eq_span_singleton_of_isSeparable (hF : IsFunctionField k K) (x : K)
    [Algebra.IsSeparable k⟮x⟯ K] :
    ∃ (y : K) (F : MvPolynomial (Fin 2) k), Irreducible F ∧ k⟮x, y⟯ = ⊤ ∧
      RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F} ∧
      F.degreeOf 1 = Module.finrank k⟮x⟯ K := by
  have : Algebra.Transcendental k K := Algebra.transcendental_def.mpr hF.exists_transcendental
  have hx : Transcendental k x := transcendental_of_isAlgebraic_adjoin
  have : FiniteDimensional k⟮x⟯ K := hF.finiteDimensional_adjoin hx
  obtain ⟨y, hy⟩ := hF.exists_adjoin_pair_eq_top_of_isSeparable x
  obtain ⟨F, hirr, hker, hdeg⟩ := exists_irreducible_ker_aeval_eq_span_singleton hx hy
  exact ⟨y, F, hirr, hy, hker, hdeg⟩

/-- **Every curve is birational to an affine plane curve.** A function field `K` of one variable
over a perfect field `k`, for instance an algebraically closed one, is generated by two elements
`x` and `y` whose relations are the multiples of an irreducible `F ∈ k[X, Y]`, so that `K` is
isomorphic over `k` to the function field `k(F)` of the affine plane curve `F = 0`.

Milestone: *Every curve is birational to an affine plane curve*. -/
theorem exists_ker_aeval_eq_span_singleton_of_perfectField [PerfectField k]
    (hF : IsFunctionField k K) :
    ∃ (x y : K) (F : MvPolynomial (Fin 2) k), Irreducible F ∧ k⟮x, y⟯ = ⊤ ∧
      RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] K) = Ideal.span {F} ∧
      Nonempty (K ≃ₐ[k] FractionRing (MvPolynomial (Fin 2) k ⧸ Ideal.span {F})) := by
  obtain ⟨x, -, hsep⟩ := hF.exists_transcendental_and_isSeparable_adjoin_of_perfectField
  obtain ⟨y, F, hirr, hy, hker, -⟩ := hF.exists_ker_aeval_eq_span_singleton_of_isSeparable x
  exact ⟨x, y, F, hirr, hy, hker, ⟨(fractionRingAlgEquivOfKerAevalEq hy hker).symm⟩⟩

end TauCeti.IsFunctionField

end
