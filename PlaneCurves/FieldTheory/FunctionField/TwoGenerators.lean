module

public import Mathlib.FieldTheory.PrimitiveElement
public import TauCeti.FieldTheory.FunctionField.SeparablyGenerated
public import PlaneCurves.FieldTheory.PrimitiveElement.OneSeparable
import TauCeti.FieldTheory.IntermediateField.Adjoin.Transcendental

/-!
# Two generators of a function field of one variable

A function field `K` of one variable over `k` is generated by two elements: `K = k(x, y)`.
When `K` is separable over `k(x)`, this is the primitive element theorem for the finite
extension `K / k(x)`. Over a perfect field it holds for every transcendental `x`, separable
or not: if `t` is a separating transcendental element and `E = k(x)(t)`, then `K / E` is
separable, since `K / k(t)` is; so `K = E(S)`, where `S` is the separable closure of `k(x)` in
`K`. Then `S = k(x)(β)` with `β` separable, so `K = k(x)(t, β)` is simple over `k(x)` by the
primitive element theorem with one separable generator.

Over an imperfect field this fails: for `k = 𝔽_p(a, b)` and `K = k(a^{1/p}, b^{1/p})(x)`, the
extension `K / k(x)` has degree `p²` and exponent one, so is not simple.

## Main results

* `TauCeti.IsFunctionField.exists_adjoin_pair_eq_top_of_isSeparable`: if `K / k(x)` is
  separable, then `K = k(x, y)` for some `y`.
* `TauCeti.IsFunctionField.exists_adjoin_pair_eq_top_of_charZero`: in characteristic zero,
  `K = k(x, y)` for every `x` transcendental over `k` and some `y`.
* `TauCeti.IsFunctionField.exists_adjoin_pair_eq_top_of_perfectField`: over a perfect field,
  `K = k(x, y)` with `x` transcendental and `K / k(x)` separable.
* `TauCeti.IsFunctionField.exists_adjoin_pair_eq_top`: over a perfect field, `K = k(x, y)`
  for every `x` transcendental over `k` and some `y`.
* `TauCeti.IsFunctionField.exists_adjoin_pair_eq_top_of_isAlgClosed`: over an algebraically
  closed field, `K = k(x, y)` for every `x ∉ k` and some `y`.

## References

* [W. Fulton, *Algebraic Curves: An Introduction to Algebraic Geometry*][Fulton2008],
  §6.5, Proposition 9(2), Problem 6.31, and Appendix A
-/

public section

open IntermediateField
open scoped IntermediateField

namespace TauCeti.IsFunctionField

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- **Two generators of a function field, for a separable `K / k(x)`**: if `K` is a function
field of one variable over `k` and `K` is separable over `k(x)`, then `K = k(x, y)` for some
`y : K`. The element `x` is then transcendental over `k`, since `K` is algebraic over `k(x)`. -/
theorem exists_adjoin_pair_eq_top_of_isSeparable (hF : IsFunctionField k K) (x : K)
    [Algebra.IsSeparable k⟮x⟯ K] : ∃ y : K, k⟮x, y⟯ = ⊤ := by
  have : Algebra.Transcendental k K := Algebra.transcendental_def.mpr hF.exists_transcendental
  have : FiniteDimensional k⟮x⟯ K :=
    hF.finiteDimensional_adjoin transcendental_of_isAlgebraic_adjoin
  obtain ⟨y, hy⟩ := Field.exists_primitive_element k⟮x⟯ K
  refine ⟨y, ?_⟩
  rw [← adjoin_simple_adjoin_simple, hy, restrictScalars_top]

/-- **Two generators of a function field in characteristic zero**: if `K` is a function field
of one variable over a field `k` of characteristic zero, then for every `x : K` transcendental
over `k` there is `y : K` with `K = k(x, y)`. -/
theorem exists_adjoin_pair_eq_top_of_charZero [CharZero k] (hF : IsFunctionField k K)
    {x : K} (hx : Transcendental k x) : ∃ y : K, k⟮x, y⟯ = ⊤ := by
  have : FiniteDimensional k⟮x⟯ K := hF.finiteDimensional_adjoin hx
  have : CharZero k⟮x⟯ := charZero_of_injective_algebraMap (algebraMap k k⟮x⟯).injective
  exact hF.exists_adjoin_pair_eq_top_of_isSeparable x

/-- **Two generators of a function field over a perfect field**: if `K` is a function field of
one variable over a perfect field `k`, then there are `x y : K` with `x` transcendental over
`k`, `K` separable over `k(x)`, and `K = k(x, y)`. -/
theorem exists_adjoin_pair_eq_top_of_perfectField [PerfectField k] (hF : IsFunctionField k K) :
    ∃ x y : K, Transcendental k x ∧ Algebra.IsSeparable k⟮x⟯ K ∧ k⟮x, y⟯ = ⊤ := by
  obtain ⟨x, hx, hsep⟩ := hF.exists_transcendental_and_isSeparable_adjoin_of_perfectField
  obtain ⟨y, hy⟩ := hF.exists_adjoin_pair_eq_top_of_isSeparable x
  exact ⟨x, y, hx, hsep, hy⟩

/-- **Two generators of a function field of one variable**: if `K` is a function field of one
variable over a perfect field `k`, then for every `x : K` transcendental over `k` there is
`y : K` with `K = k(x, y)`. Here `K / k(x)` need not be separable.

Milestone: *Two-generator presentation of a function field of one variable*. -/
theorem exists_adjoin_pair_eq_top [PerfectField k] (hF : IsFunctionField k K) {x : K}
    (hx : Transcendental k x) : ∃ y : K, k⟮x, y⟯ = ⊤ := by
  have : FiniteDimensional k⟮x⟯ K := hF.finiteDimensional_adjoin hx
  obtain ⟨t, -, ht⟩ := hF.exists_transcendental_and_isSeparable_adjoin_of_perfectField
  -- The separable closure `S` of `k(x)` in `K` is `k(x)(β)`.
  let S := separableClosure k⟮x⟯ K
  obtain ⟨β, hβ⟩ := Field.exists_primitive_element k⟮x⟯ S
  have hS : k⟮x⟯⟮(β : K)⟯ = S := by rw [← lift_adjoin_simple, hβ, lift_top]
  -- `K` is separable over `E = k(x)(t)`, since it is over `k(t)`.
  let E := k⟮x⟯⟮t⟯
  have : Algebra.IsSeparable E K := by
    have h : k⟮t⟯ ≤ E.restrictScalars k := by
      rw [adjoin_simple_le_iff]; exact mem_adjoin_simple_self _ t
    let _ : Algebra k⟮t⟯ E := (inclusion h).toAlgebra
    have : IsScalarTower k⟮t⟯ E K := IsScalarTower.of_algebraMap_eq (congrFun rfl)
    exact Algebra.isSeparable_tower_top_of_isSeparable k⟮t⟯ E K
  -- Hence `K = E(S) = k(x)(t, β)`.
  have h1 := separableClosure.adjoin_eq_of_isAlgebraic_of_isSeparable (F := k⟮x⟯) (E := E) K
  have htop : k⟮x⟯⟮t, (β : K)⟯ = ⊤ := by
    have h2 := congrArg (restrictScalars k⟮x⟯) h1
    rw [adjoin_adjoin_left, restrictScalars_top] at h2
    rw [eq_top_iff, ← h2, adjoin_le_iff]
    rintro a (rfl | ha)
    · exact subset_adjoin _ _ (Set.mem_insert _ _)
    · change a ∈ S at ha; rw [← hS] at ha
      exact adjoin_simple_le_iff.2 (subset_adjoin _ _ (by simp)) ha
  obtain ⟨γ, hγ⟩ := Field.exists_adjoin_pair_eq_adjoin_simple k⟮x⟯
    (Algebra.IsIntegral.isIntegral t) (mem_separableClosure_iff.1 β.2)
  refine ⟨γ, ?_⟩
  rw [← adjoin_simple_adjoin_simple, ← hγ, htop, restrictScalars_top]

/-- **Two generators of a function field over an algebraically closed field**: if `K` is a
function field of one variable over an algebraically closed field `k`, then for every
`x ∈ K \ k` there is `y : K` with `K = k(x, y)`. -/
theorem exists_adjoin_pair_eq_top_of_isAlgClosed [IsAlgClosed k] (hF : IsFunctionField k K)
    {x : K} (hx : x ∉ (⊥ : IntermediateField k K)) : ∃ y : K, k⟮x, y⟯ = ⊤ := by
  refine hF.exists_adjoin_pair_eq_top fun halg ↦ hx ?_
  have := isAlgebraic_adjoin_simple halg.isIntegral
  rw [← eq_bot_of_isAlgClosed_of_isAlgebraic k⟮x⟯]
  exact mem_adjoin_simple_self k x

end TauCeti.IsFunctionField

end
