/-!
# Fulton's properties characterize the local intersection number

Fulton (§3.3, Theorem 3) shows that there is exactly one function `I(P, F ∩ G)` of a point
`P ∈ k²` and two plane curves `F, G ∈ k[X, Y]` with values in `ℕ ∪ {∞}` that satisfies his seven
properties (1)–(7), and that it is `dim_k 𝒪_P(𝔸²) ⧸ (F, G)`. This file packages the properties as
a structure and proves this characterization, together with Fulton's stronger uniqueness
statement, which uses only (1), (2), invariance under translations, (4), (6), (7) and
`I((0, 0), X ∩ Y) = 1`.

The uniqueness proof is Fulton's procedure: translate `P` to the origin and argue by induction on
the value of the intersection number and, inside it, on `deg F(X, 0) + deg G(X, 0)`. If
`F(X, 0) = 0`, then `F = Y H` and `I(Y ∩ G)` is the order of vanishing of `G(X, 0)` at `0`;
otherwise subtracting a multiple of `F` from `G` lowers `deg G(X, 0)`. Nothing in it needs `k`
to be algebraically closed.

## Main definitions

* `PlaneCurves.Affine.IntersectionNumberAxioms J`: the function `J` satisfies Fulton's properties
  (1)–(7).

## Main results

* `PlaneCurves.Affine.intersectionNumberAxioms_intersectionNumber`: the intersection number
  satisfies Fulton's properties.
* `PlaneCurves.Affine.eq_intersectionNumber_of_properties`: Fulton's stronger uniqueness, from
  (1), (2), invariance under translations, (4), (6), (7) and `J((0, 0), X ∩ Y) = 1`.
* `PlaneCurves.Affine.intersectionNumberAxioms_iff`: a function satisfies Fulton's properties
  iff it is the intersection number.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §3.3, Theorem 3
-/

public section

open MvPolynomial

namespace PlaneCurves.Affine

variable {k : Type*} [Field k]

/-- Fulton's properties (1)–(7) of the local intersection number (§3.3), for a function `J`
assigning to each point `P ∈ k²` and polynomials `F, G ∈ k[X, Y]` a value `J P F G ∈ ℕ ∪ {∞}`:
1. `J P F G` is finite iff `F` and `G` intersect properly at `P`;
2. `J P F G = 0` iff `F(P) ≠ 0` or `G(P) ≠ 0`, and `J P (F U) G = J P F G` when `U(P) ≠ 0`;
3. `J` is invariant under affine changes of coordinates, which are generated by translations
   and invertible linear substitutions;
4. `J P F G = J P G F`;
5. `J P F G ≥ m_P(F) m_P(G)`, with equality for nonzero `F` and `G` iff their leading forms at
   `P` are relatively prime; over an algebraically closed field this means that `F` and `G` have
   no tangent line in common at `P`
   (`IntersectionNumberAxioms.eq_mul_orderAt_iff_not_exists_isTangentAt`);
6. `J P F (G H) = J P F G + J P F H`, which with (4) gives Fulton's
   `J P F G = ∑ rᵢ sⱼ J P Fᵢ Gⱼ` for `F = ∏ Fᵢ ^ rᵢ` and `G = ∏ Gⱼ ^ sⱼ`;
7. `J P F (G + A F) = J P F G`. -/
structure IntersectionNumberAxioms
    (J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞) : Prop where
  /-- Property (1): finiteness exactly for proper intersections. -/
  ne_top_iff (P : Fin 2 → k) (F G : MvPolynomial (Fin 2) k) :
    J P F G ≠ ⊤ ↔ IntersectProperlyAt F G P
  /-- Property (2): vanishing exactly away from a common point. -/
  eq_zero_iff (P : Fin 2 → k) (F G : MvPolynomial (Fin 2) k) :
    J P F G = 0 ↔ eval P F ≠ 0 ∨ eval P G ≠ 0
  /-- Property (2): only the components through `P` matter. -/
  mul_left_of_eval_ne_zero (P : Fin 2 → k) (F G U : MvPolynomial (Fin 2) k) :
    eval P U ≠ 0 → J P (F * U) G = J P F G
  /-- Property (3): invariance under translations. -/
  taylor (P : Fin 2 → k) (F G : MvPolynomial (Fin 2) k) :
    J 0 (taylor P F) (taylor P G) = J P F G
  /-- Property (3): invariance under invertible linear substitutions. -/
  linearSubst (M : Matrix.GeneralLinearGroup (Fin 2) k) (P : Fin 2 → k)
    (F G : MvPolynomial (Fin 2) k) :
    J P (linearSubst M.1 F) (linearSubst M.1 G) = J (M.1.mulVec P) F G
  /-- Property (4): symmetry. -/
  comm (P : Fin 2 → k) (F G : MvPolynomial (Fin 2) k) : J P F G = J P G F
  /-- Property (5): the bound by the product of the multiplicities. -/
  mul_orderAt_le (P : Fin 2 → k) (F G : MvPolynomial (Fin 2) k) :
    F.orderAt P * G.orderAt P ≤ J P F G
  /-- Property (5): the equality case. -/
  eq_mul_orderAt_iff (P : Fin 2 → k) {F G : MvPolynomial (Fin 2) k} (hF : F ≠ 0) (hG : G ≠ 0) :
    J P F G = F.orderAt P * G.orderAt P ↔
      IsRelPrime (F.leadingFormAt P) (G.leadingFormAt P)
  /-- Property (6): additivity. -/
  mul_right (P : Fin 2 → k) (F G H : MvPolynomial (Fin 2) k) :
    J P F (G * H) = J P F G + J P F H
  /-- Property (7): only the ideal `(F, G)` matters. -/
  add_mul (P : Fin 2 → k) (F G A : MvPolynomial (Fin 2) k) : J P F (G + A * F) = J P F G

/-- The intersection number satisfies Fulton's properties (1)–(7), over any field. -/
theorem intersectionNumberAxioms_intersectionNumber :
    IntersectionNumberAxioms (intersectionNumber (k := k)) where
  ne_top_iff _ _ _ := intersectionNumber_ne_top_iff
  eq_zero_iff _ _ _ := intersectionNumber_eq_zero_iff
  mul_left_of_eval_ne_zero _ _ _ _ := intersectionNumber_mul_left_of_eval_ne_zero
  taylor := intersectionNumber_taylor
  linearSubst := intersectionNumber_linearSubst
  comm := intersectionNumber_comm
  mul_orderAt_le := mul_orderAt_le_intersectionNumber
  eq_mul_orderAt_iff _ _ _ := intersectionNumber_eq_mul_orderAt_iff
  mul_right := intersectionNumber_mul_right
  add_mul := intersectionNumber_add_mul

namespace IntersectionNumberAxioms

variable {J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞}
  (h : IntersectionNumberAxioms J)
include h

/-- Property (6) in the first argument. -/
theorem mul_left (P : Fin 2 → k) (F G H : MvPolynomial (Fin 2) k) :
    J P (F * G) H = J P F H + J P G H := by
  rw [h.comm, h.mul_right, h.comm P H, h.comm P H]

/-- The coordinate axes meet with intersection number one at the origin. -/
theorem X_zero_X_one : J 0 (X 0) (X 1) = 1 := by
  have hX (i : Fin 2) := (isHomogeneous_X k i)
  have h' := h.eq_mul_orderAt_iff 0 (X_ne_zero 0) (X_ne_zero 1)
  rw [(hX 0).orderAt_zero (X_ne_zero 0), (hX 1).orderAt_zero (X_ne_zero 1),
    (hX 0).leadingFormAt_zero, (hX 1).leadingFormAt_zero, Nat.cast_one, mul_one] at h'
  exact h'.2 ((irreducible_of_isHomogeneous_one (hX 0) (X_ne_zero 0)).isRelPrime_iff_not_dvd.2
    (by simp))

/-- Over an algebraically closed field, the equality case of property (5) says that equality
holds iff `F` and `G` have no tangent line in common at `P`. -/
theorem eq_mul_orderAt_iff_not_exists_isTangentAt [IsAlgClosed k] (P : Fin 2 → k)
    {F G : MvPolynomial (Fin 2) k} (hF : F ≠ 0) (hG : G ≠ 0) :
    J P F G = F.orderAt P * G.orderAt P ↔ ¬∃ L, IsTangentAt F P L ∧ IsTangentAt G P L :=
  (h.eq_mul_orderAt_iff P hF hG).trans (isRelPrime_leadingFormAt_iff_not_exists_isTangentAt hF)

end IntersectionNumberAxioms

/-! ### Uniqueness -/

section Uniqueness

/-- The properties that Fulton's uniqueness proof uses, at the origin. -/
private structure UniquenessHyps
    (J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞) : Prop where
  ne_top_iff (F G : MvPolynomial (Fin 2) k) : J 0 F G ≠ ⊤ ↔ IntersectProperlyAt F G 0
  eq_zero_iff (F G : MvPolynomial (Fin 2) k) : J 0 F G = 0 ↔ eval 0 F ≠ 0 ∨ eval 0 G ≠ 0
  comm (F G : MvPolynomial (Fin 2) k) : J 0 F G = J 0 G F
  mul_right (F G H : MvPolynomial (Fin 2) k) : J 0 F (G * H) = J 0 F G + J 0 F H
  add_mul (F G A : MvPolynomial (Fin 2) k) : J 0 F (G + A * F) = J 0 F G
  X_zero_X_one : J 0 (X 0) (X 1) = 1

/-- The polynomial `F(X, 0) ∈ k[X]`. -/
private noncomputable abbrev restrictX : MvPolynomial (Fin 2) k →ₐ[k] Polynomial k :=
  aeval ![Polynomial.X, 0]

private theorem restrictX_aeval (p : Polynomial k) :
    restrictX (Polynomial.aeval (X 0 : MvPolynomial (Fin 2) k) p) = p := by
  rw [← Polynomial.aeval_algHom_apply]
  simp

private theorem eval_zero_eq_eval_restrictX (F : MvPolynomial (Fin 2) k) :
    eval 0 F = (restrictX F).eval 0 := by
  have : (Polynomial.aeval (0 : k)).comp (restrictX (k := k)) = aeval (0 : Fin 2 → k) := by
    ext i
    fin_cases i <;> simp
  rw [← coe_aeval_eq_eval, ← this, ← Polynomial.coe_aeval_eq_eval]
  rfl

private theorem X_one_dvd_sub_aeval_restrictX (F : MvPolynomial (Fin 2) k) :
    X 1 ∣ F - Polynomial.aeval (X 0) (restrictX F) := by
  have : (Polynomial.aeval (X 0 : MvPolynomial (Fin 2) k)).comp (restrictX (k := k)) =
      bind₁ (Function.update X 1 0) := by
    ext i
    fin_cases i <;> simp
  have h := congr($this F)
  rw [AlgHom.comp_apply] at h
  rw [h]
  exact X_dvd_sub_bind₁_update_X_zero 1 F

variable {J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞}

private theorem UniquenessHyps.mul_left (h : UniquenessHyps J) (F G H : MvPolynomial (Fin 2) k) :
    J 0 (F * G) H = J 0 F H + J 0 G H := by
  rw [h.comm, h.mul_right, h.comm H, h.comm H]

private theorem UniquenessHyps.pow_right (h : UniquenessHyps J) (F G : MvPolynomial (Fin 2) k)
    (n : ℕ) : J 0 F (G ^ n) = n * J 0 F G := by
  induction n with
  | zero =>
    rw [pow_zero, Nat.cast_zero, zero_mul]
    exact (h.eq_zero_iff F 1).2 (.inr (by simp))
  | succ n ih => rw [pow_succ, h.mul_right, ih, Nat.cast_succ, add_one_mul]

/-- `J(Y ∩ G)` is the order of vanishing of `G(X, 0)` at `0`. -/
private theorem UniquenessHyps.X_one_left (h : UniquenessHyps J) {G : MvPolynomial (Fin 2) k}
    (hG : restrictX G ≠ 0) : J 0 (X 1) G = (restrictX G).rootMultiplicity 0 := by
  set g := restrictX G
  set m := g.rootMultiplicity 0
  obtain ⟨B, hB⟩ := X_one_dvd_sub_aeval_restrictX G
  obtain ⟨u, hu, hXu⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd g hG 0
  simp only [map_zero, sub_zero] at hu hXu
  have hu0 : eval 0 (Polynomial.aeval (X 0 : MvPolynomial (Fin 2) k) u) ≠ 0 := by
    rwa [eval_zero_eq_eval_restrictX, restrictX_aeval, ← Polynomial.coeff_zero_eq_eval_zero, Ne,
      ← Polynomial.X_dvd_iff]
  have hg : Polynomial.aeval (X 0 : MvPolynomial (Fin 2) k) g =
      X 0 ^ m * Polynomial.aeval (X 0) u := by
    conv_lhs => rw [hu]
    simp [m]
  have hG' : G = Polynomial.aeval (X 0) g + B * X 1 := by
    rw [mul_comm, ← hB]
    ring
  rw [hG', h.add_mul, hg, h.mul_right, h.pow_right, (h.eq_zero_iff _ _).2 (.inr hu0), h.comm,
    h.X_zero_X_one, mul_one, add_zero]

/-- The degree of `F(X, 0)`. -/
private noncomputable abbrev deg (F : MvPolynomial (Fin 2) k) : ℕ := (restrictX F).natDegree

/-- Fulton's Euclidean step: if `0 < deg F(X, 0) ≤ deg G(X, 0)`, a multiple of `F` can be
subtracted from `G` to lower `deg G(X, 0)`. -/
private theorem exists_deg_add_mul_lt {F G : MvPolynomial (Fin 2) k} (hle : deg F ≤ deg G)
    (hr : deg F ≠ 0) : ∃ A, deg (G + A * F) < deg G := by
  set f := restrictX F
  set g := restrictX G
  have hf : f ≠ 0 := fun h0 => hr (by simp [deg, f, h0])
  have hg : g ≠ 0 := by
    rintro h0
    have h1 : deg G = 0 := by change g.natDegree = 0; rw [h0, Polynomial.natDegree_zero]
    omega
  set c := g.leadingCoeff / f.leadingCoeff
  have hc : c ≠ 0 := div_ne_zero (Polynomial.leadingCoeff_ne_zero.2 hg)
    (Polynomial.leadingCoeff_ne_zero.2 hf)
  set q := Polynomial.C c * Polynomial.X ^ (g.natDegree - f.natDegree) * f
  have hq0 : q ≠ 0 := mul_ne_zero (by simp [hc]) hf
  have hqd : q.natDegree = g.natDegree := by
    rw [Polynomial.natDegree_mul (by simp [hc]) hf, Polynomial.natDegree_C_mul_X_pow _ _ hc]
    exact Nat.sub_add_cancel hle
  have hql : q.leadingCoeff = g.leadingCoeff := by
    rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C_mul_X_pow]
    exact div_mul_cancel₀ _ (Polynomial.leadingCoeff_ne_zero.2 hf)
  refine ⟨-(C c * X 0 ^ (g.natDegree - f.natDegree)), ?_⟩
  have hρ : restrictX (G + -(C c * X 0 ^ (g.natDegree - f.natDegree)) * F) = g - q := by
    simp [q, f, g, sub_eq_add_neg]
  change (restrictX _).natDegree < g.natDegree
  rw [hρ]
  rcases eq_or_ne (g - q) 0 with h0 | h0
  · rw [h0, Polynomial.natDegree_zero]
    change 0 < deg G
    omega
  refine Polynomial.natDegree_lt_natDegree h0 (Polynomial.degree_sub_lt_left ?_ hg hql.symm)
  rw [Polynomial.degree_eq_natDegree hg, Polynomial.degree_eq_natDegree hq0, hqd]

/-- Two functions with the properties that Fulton's uniqueness proof uses agree at the origin
wherever the first is finite. -/
private theorem UniquenessHyps.eq_of_eq {J₁ J₂ : (Fin 2 → k) → MvPolynomial (Fin 2) k →
    MvPolynomial (Fin 2) k → ℕ∞} (h₁ : UniquenessHyps J₁) (h₂ : UniquenessHyps J₂) (n : ℕ) :
    ∀ F G, J₁ 0 F G = n → J₂ 0 F G = n := by
  induction n using Nat.strong_induction_on with | _ n ihn => ?_
  suffices ∀ N F G, deg F + deg G = N → J₁ 0 F G = n → J₂ 0 F G = n from
    fun F G => this _ F G rfl
  intro N
  induction N using Nat.strong_induction_on with | _ N ihN => ?_
  intro F G hN hn
  rcases eq_or_ne n 0 with rfl | hn0
  · exact (h₂.eq_zero_iff F G).2 ((h₁.eq_zero_iff F G).1 (by exact_mod_cast hn))
  have hzero (F G : MvPolynomial (Fin 2) k) (hn : J₁ 0 F G = n) :
      eval 0 F = 0 ∧ eval 0 G = 0 := by
    by_contra! hc
    have := (h₁.eq_zero_iff F G).2 (by tauto)
    rw [hn] at this
    exact hn0 (by exact_mod_cast this)
  -- the case `deg F(X, 0) ≤ deg G(X, 0)`; the other one follows by symmetry
  have key (F G : MvPolynomial (Fin 2) k) (hle : deg F ≤ deg G)
      (hN : deg F + deg G = N) (hn : J₁ 0 F G = n) : J₂ 0 F G = n := by
    obtain ⟨hF0, hG0⟩ := hzero F G hn
    by_cases hr : deg F = 0
    · -- `F(X, 0) = 0`, so `F = Y H`
      have hρF : restrictX F = 0 := by
        rw [deg] at hr
        rw [Polynomial.eq_C_of_natDegree_eq_zero hr, Polynomial.coeff_zero_eq_eval_zero,
          ← eval_zero_eq_eval_restrictX, hF0, map_zero]
      obtain ⟨H, rfl⟩ : X 1 ∣ F := by simpa [hρF] using X_one_dvd_sub_aeval_restrictX F
      have hρG : restrictX G ≠ 0 := by
        intro hρG
        have hYG : X 1 ∣ G := by simpa [hρG] using X_one_dvd_sub_aeval_restrictX G
        refine intersectProperlyAt_def.1
          ((h₁.ne_top_iff _ G).1 (by rw [hn]; exact ENat.natCast_ne_top n)) (X 1)
          (irreducible_of_isHomogeneous_one (isHomogeneous_X k 1) (X_ne_zero 1))
          (dvd_mul_right _ _) hYG (by simp)
      set m := (restrictX G).rootMultiplicity 0
      have hm : 0 < m := (Polynomial.rootMultiplicity_pos hρG).2
        (by rw [Polynomial.IsRoot, ← eval_zero_eq_eval_restrictX, hG0])
      rw [h₁.mul_left, h₁.X_one_left hρG] at hn
      obtain ⟨x, hx⟩ := ENat.ne_top_iff_exists.1 (show J₁ 0 H G ≠ ⊤ from fun htop => by
        rw [htop, add_top] at hn
        exact ENat.top_ne_natCast n hn)
      rw [← hx] at hn
      norm_cast at hn
      rw [h₂.mul_left, h₂.X_one_left hρG, ihn x (by omega) H G hx.symm]
      exact_mod_cast hn
    · -- subtract a multiple of `F` from `G` to lower `deg G(X, 0)`
      obtain ⟨A, hA⟩ := exists_deg_add_mul_lt hle hr
      rw [← h₂.add_mul F G A]
      exact ihN _ (by omega) F (G + A * F) rfl (by rw [h₁.add_mul]; exact hn)
  rcases le_total (deg F) (deg G) with hle | hle
  · exact key F G hle hN hn
  · rw [h₂.comm]
    exact key G F hle (by omega) (by rw [h₁.comm]; exact hn)

/-- **Fulton's uniqueness theorem**, in the stronger form of §3.3: a function `J` with property
(1), the vanishing criterion of property (2), invariance under translations, properties (4), (6)
and (7), and `J((0, 0), X ∩ Y) = 1` is the intersection number. Over any field. -/
theorem eq_intersectionNumber_of_properties
    {J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞}
    (ne_top_iff : ∀ P F G, J P F G ≠ ⊤ ↔ IntersectProperlyAt F G P)
    (eq_zero_iff : ∀ P F G, J P F G = 0 ↔ eval P F ≠ 0 ∨ eval P G ≠ 0)
    (taylor : ∀ P F G, J 0 (taylor P F) (taylor P G) = J P F G)
    (comm : ∀ P F G, J P F G = J P G F)
    (mul_right : ∀ P F G H, J P F (G * H) = J P F G + J P F H)
    (add_mul : ∀ P F G A, J P F (G + A * F) = J P F G)
    (X_zero_X_one : J 0 (X 0) (X 1) = 1) :
    J = intersectionNumber := by
  have hJ : UniquenessHyps J := ⟨ne_top_iff 0, eq_zero_iff 0, comm 0, mul_right 0, add_mul 0,
    X_zero_X_one⟩
  have hI : UniquenessHyps (intersectionNumber (k := k)) :=
    ⟨fun _ _ => intersectionNumber_ne_top_iff, fun _ _ => intersectionNumber_eq_zero_iff,
      intersectionNumber_comm 0, intersectionNumber_mul_right 0, intersectionNumber_add_mul 0,
      by simpa using intersectionNumber_X_sub_C_X_sub_C (0 : Fin 2 → k)⟩
  funext P F G
  rw [← taylor, ← intersectionNumber_taylor]
  by_cases htop : intersectionNumber 0 (MvPolynomial.taylor P F) (MvPolynomial.taylor P G) = ⊤
  · rw [htop]
    by_contra hne
    exact intersectionNumber_ne_top_iff.2 ((ne_top_iff _ _ _).1 hne) htop
  · obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.1 htop
    rw [← hn]
    exact hI.eq_of_eq hJ n _ _ hn.symm

end Uniqueness

/-- A function with Fulton's properties (1)–(7) is the intersection number. -/
theorem IntersectionNumberAxioms.eq_intersectionNumber
    {J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞}
    (h : IntersectionNumberAxioms J) : J = intersectionNumber :=
  eq_intersectionNumber_of_properties h.ne_top_iff h.eq_zero_iff h.taylor h.comm h.mul_right
    h.add_mul h.X_zero_X_one

/-- **Characterization of the local intersection number by Fulton's seven properties**
(Fulton, §3.3, Theorem 3). A function `J` assigning to each `P ∈ k²` and `F, G ∈ k[X, Y]` a
value in `ℕ ∪ {∞}` satisfies Fulton's properties (1)–(7) (`IntersectionNumberAxioms`) iff it is
the intersection number `I(P, F ∩ G) = dim_k 𝒪_P(𝔸²) ⧸ (F, G)`. So there is exactly one such
function. This holds over any field, with "no common tangent" in property (5) read as "the
leading forms are relatively prime"; over an algebraically closed field the two agree
(`IntersectionNumberAxioms.eq_mul_orderAt_iff_not_exists_isTangentAt`). The stronger
uniqueness from fewer properties is `eq_intersectionNumber_of_properties`.

Milestone: *Characterization of the local intersection number by Fulton's seven properties*. -/
theorem intersectionNumberAxioms_iff
    {J : (Fin 2 → k) → MvPolynomial (Fin 2) k → MvPolynomial (Fin 2) k → ℕ∞} :
    IntersectionNumberAxioms J ↔ J = intersectionNumber :=
  ⟨IntersectionNumberAxioms.eq_intersectionNumber,
    fun h => h ▸ intersectionNumberAxioms_intersectionNumber⟩

end PlaneCurves.Affine

end
