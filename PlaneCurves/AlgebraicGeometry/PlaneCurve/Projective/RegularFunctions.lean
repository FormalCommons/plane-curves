/-!
# Regular functions on a set of points of a projective plane curve

Let `C : F = 0` be an irreducible projective plane curve over a field `k`, with function field
`k(C)` and local rings `𝒪_P(C) ⊆ k(C)`. For a set `U` of points of `C`, the ring of functions
regular on `U` is `Γ(U) = ⋂_{P ∈ U} 𝒪_P(C)`, a `k`-subalgebra of `k(C)` (Fulton, §7.5).

For a form `G` of degree `m` with `F ∤ G`, the ring `A_G` of the basic open set
`D(G) = {P ∈ C | G(P) ≠ 0}` is the `k`-subalgebra of `k(C)` of the fractions `H / Gʳ` with `H` a
form of degree `m r`. It is contained in `Γ(D(G))`, generated by the fractions `M / G` with `M` a
monomial of degree `m`, and, for `m ≠ 0`, it has fraction field `k(C)` and its localization at a
point `P ∈ D(G)` is `𝒪_P(C)`: `f / g = (f gᵐ⁻¹ / Gᵉ) / (gᵐ / Gᵉ)` for forms `f`, `g` of
degree `e`.

## Main definitions

* `PlaneCurves.Projective.regularFunctions hF U`: the ring `Γ(U)` of rational functions on `C`
  regular at every point of `U`.
* `PlaneCurves.Projective.awaySubalgebra hF hG hFG`: the ring `A_G` of fractions `H / Gʳ`.
* `PlaneCurves.Projective.awaySubalgebraInclusion hF hG hFG hGP`: the inclusion `A_G → 𝒪_P(C)`
  for `G(P) ≠ 0`.

## Main results

* `mem_regularFunctions_iff`, `coe_regularFunctions`, `regularFunctions_empty`,
  `regularFunctions_union`, `regularFunctions_singleton`.
* `regularFunctions_le_holomorphyRing`: `Γ(U)` is contained in the holomorphy ring of the places
  centred in `U`.
* `awaySubalgebra_le_regularFunctions`: `A_G ⊆ Γ(D(G))`.
* `awaySubalgebra_eq_adjoin`, `finiteType_awaySubalgebra`: `A_G` is generated by the fractions
  `M / G`, so it is a finitely generated `k`-algebra.
* `isFractionRing_awaySubalgebra`: `k(C)` is the fraction field of `A_G`, for `m ≠ 0`.
* `isLocalization_localSubring_awaySubalgebra`: `𝒪_P(C)` is the localization of `A_G` at the
  prime of the functions vanishing at `P`, for `m ≠ 0` and `G(P) ≠ 0`.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §7.5
-/

public section

open MvPolynomial PlaneCurves.ProjectiveSpace TauCeti
open TauCeti.AlgebraicGeometry

namespace PlaneCurves.Projective

variable {k : Type*} [Field k] {F : MvPolynomial (Fin 3) k} {d : ℕ}
  (hF : F.IsHomogeneous d) [Fact (Irreducible F)]

/-! ### Regular functions on a set of points -/

/-- The ring `Γ(U) = ⋂_{P ∈ U} 𝒪_P(C)` of rational functions on the irreducible projective plane
curve `C : F = 0` that are regular at every point of `U`. -/
noncomputable def regularFunctions
    (U : Set (zeroLocus (projectivePlaneCurve.ideal hF : Set (MvPolynomial (Fin 3) k)))) :
    Subalgebra k (functionField hF) where
  carrier := {z | ∀ P ∈ U, z ∈ (localSubring hF P).toSubring}
  mul_mem' ha hb P hP := mul_mem (ha P hP) (hb P hP)
  add_mem' ha hb P hP := add_mem (ha P hP) (hb P hP)
  algebraMap_mem' a P _ := (algebraMap k (localSubring hF P).toSubring a).2

variable {hF}
variable {U V : Set (zeroLocus (projectivePlaneCurve.ideal hF : Set (MvPolynomial (Fin 3) k)))}

/-- A rational function lies in `Γ(U)` iff it lies in `𝒪_P(C)` for every `P ∈ U`. -/
@[simp]
theorem mem_regularFunctions_iff {z : functionField hF} :
    z ∈ regularFunctions hF U ↔ ∀ P ∈ U, z ∈ (localSubring hF P).toSubring :=
  Iff.rfl

theorem coe_regularFunctions :
    (regularFunctions hF U : Set (functionField hF)) =
      ⋂ P ∈ U, ((localSubring hF P).toSubring : Set (functionField hF)) := by
  ext
  simp

variable (hF) in
/-- The ring of regular functions is antitone in the set of points. -/
theorem antitone_regularFunctions : Antitone (regularFunctions hF) :=
  fun _ _ h _ hz P hP ↦ hz P (h hP)

theorem regularFunctions_anti (h : U ⊆ V) : regularFunctions hF V ≤ regularFunctions hF U :=
  antitone_regularFunctions hF h

variable (hF) in
@[simp]
theorem regularFunctions_empty : regularFunctions hF ∅ = ⊤ := by
  ext
  simp

theorem regularFunctions_union :
    regularFunctions hF (U ∪ V) = regularFunctions hF U ⊓ regularFunctions hF V := by
  ext z
  simp only [mem_regularFunctions_iff, Algebra.mem_inf, Set.mem_union]
  exact ⟨fun h ↦ ⟨fun P hP ↦ h P (.inl hP), fun P hP ↦ h P (.inr hP)⟩,
    fun h P hP ↦ hP.elim (h.1 P) (h.2 P)⟩

variable (hF) in
/-- The functions regular at a point `P` are the elements of the local ring `𝒪_P(C)`. -/
@[simp]
theorem regularFunctions_singleton
    (P : zeroLocus (projectivePlaneCurve.ideal hF : Set (MvPolynomial (Fin 3) k))) :
    (regularFunctions hF {P}).toSubring = (localSubring hF P).toSubring := by
  ext
  simp

variable (hF U) in
/-- A function regular on `U` is regular at every place of `k(C)` centred in `U`. -/
theorem regularFunctions_le_holomorphyRing [IsAlgClosed k] :
    regularFunctions hF U ≤ holomorphyRing (center hF ⁻¹' U) :=
  fun _ hz ↦ mem_holomorphyRing_iff.2 fun Q hQ ↦ localSubring_center_le Q (hz _ hQ)

/-! ### The ring of a basic open set -/

variable (hF)
variable {m : ℕ} {G : MvPolynomial (Fin 3) k} (hG : G.IsHomogeneous m) (hFG : ¬ F ∣ G)

/-- The ring `A_G` of the fractions `H / Gʳ`, `H` a form of degree `m r`, for a form `G` of degree
`m` not divisible by `F`: the ring of the basic open set `D(G) = {P ∈ C | G(P) ≠ 0}`. -/
noncomputable def awaySubalgebra : Subalgebra k (functionField hF) where
  carrier := {z | ∃ (r : ℕ) (H : MvPolynomial (Fin 3) k) (hH : H.IsHomogeneous (m * r)),
    z = functionField.mk hH (hG.pow r)
      (projectivePlaneCurve.pow_notMem_ideal hF hFG r)}
  mul_mem' := by
    rintro _ _ ⟨r, H, hH, rfl⟩ ⟨s, H', hH', rfl⟩
    refine ⟨r + s, H * H', by rw [mul_add]; exact hH.mul hH', ?_⟩
    rw [functionField.mk_mul_mk]
    exact functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by ring)
  add_mem' := by
    rintro _ _ ⟨r, H, hH, rfl⟩ ⟨s, H', hH', rfl⟩
    have hGI := projectivePlaneCurve.pow_notMem_ideal hF hFG
    have h₁ := hH.mul (hG.pow s)
    have h₂ : (H' * G ^ r).IsHomogeneous (m * r + m * s) := by
      rw [add_comm]; exact hH'.mul (hG.pow r)
    have hrs := (hG.pow r).mul (hG.pow s)
    have hrsI : G ^ r * G ^ s ∉ projectivePlaneCurve.ideal hF := by
      rw [← pow_add]; exact hGI _
    refine ⟨r + s, H * G ^ s + H' * G ^ r, by rw [mul_add]; exact h₁.add h₂, ?_⟩
    rw [functionField.mk_eq_mk_of_mul_eq hH (hG.pow r) (hGI r) h₁ hrs hrsI (by ring),
      functionField.mk_eq_mk_of_mul_eq hH' (hG.pow s) (hGI s) h₂ hrs hrsI (by ring),
      functionField.mk_add_mk_self]
    exact functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by ring)
  algebraMap_mem' a := by
    have h1 : (1 : MvPolynomial (Fin 3) k) ∉ projectivePlaneCurve.ideal hF := by
      simpa using projectivePlaneCurve.pow_notMem_ideal hF hFG 0
    refine ⟨0, C a, by rw [mul_zero]; exact isHomogeneous_C _ a, ?_⟩
    rw [functionField.algebraMap_eq_mk a h1]
    exact functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by simp)

variable {hF hG hFG}

/-- An element of `A_G` is a fraction `H / Gʳ` with `H` a form of degree `m r`. -/
theorem mem_awaySubalgebra_iff {z : functionField hF} :
    z ∈ awaySubalgebra hF hG hFG ↔
      ∃ (r : ℕ) (H : MvPolynomial (Fin 3) k) (hH : H.IsHomogeneous (m * r)),
        z = functionField.mk hH (hG.pow r)
          (projectivePlaneCurve.pow_notMem_ideal hF hFG r) :=
  Iff.rfl

/-- A fraction `H / Gʳ` with `H` a form of degree `m r` lies in `A_G`. -/
theorem mk_mem_awaySubalgebra {r : ℕ} {H : MvPolynomial (Fin 3) k}
    (hH : H.IsHomogeneous (m * r)) (hGr : (G ^ r).IsHomogeneous (m * r))
    (hGrI : G ^ r ∉ projectivePlaneCurve.ideal hF) :
    functionField.mk hH hGr hGrI ∈ awaySubalgebra hF hG hFG :=
  ⟨r, H, hH, rfl⟩

variable {P : zeroLocus (projectivePlaneCurve.ideal hF : Set (MvPolynomial (Fin 3) k))}

variable (hF hG hFG) in
/-- `A_G ⊆ 𝒪_P(C)` for a point `P` with `G(P) ≠ 0`. -/
theorem awaySubalgebra_le_localSubring (hGP : eval P.1.rep G ≠ 0) :
    (awaySubalgebra hF hG hFG).toSubring ≤ (localSubring hF P).toSubring := by
  rintro _ ⟨r, H, hH, rfl⟩
  exact mem_localSubring_iff.2 ⟨m * r, H, G ^ r, hH, hG.pow r, by simpa using pow_ne_zero r hGP,
    rfl⟩

variable (hF hG hFG) in
/-- **`A_G ⊆ Γ(D(G))`**: the fractions `H / Gʳ` are regular on the basic open set `D(G)`. -/
theorem awaySubalgebra_le_regularFunctions :
    awaySubalgebra hF hG hFG ≤ regularFunctions hF {P | eval P.1.rep G ≠ 0} :=
  fun _ hz _ hP ↦ awaySubalgebra_le_localSubring hF hG hFG hP hz

/-- A fraction `c Xˢ / Gʳ`, for a monomial `Xˢ` of degree `m r`, is a product of `r` fractions
`Xᵘ / G` with `Xᵘ` a monomial of degree `m`, and a constant. -/
private theorem mk_monomial_mem_adjoin (r : ℕ) (s : Fin 3 →₀ ℕ) (c : k)
    (hs : s.degree = m * r) :
    functionField.mk (isHomogeneous_monomial c hs) (hG.pow r)
        (projectivePlaneCurve.pow_notMem_ideal hF hFG r) ∈
      Algebra.adjoin k {z | ∃ (u : Fin 3 →₀ ℕ) (hu : u.degree = m),
        z = functionField.mk (isHomogeneous_monomial (1 : k) hu) hG
          (projectivePlaneCurve.notMem_ideal_of_not_dvd hF hFG)} := by
  induction r generalizing s c with
  | zero =>
    obtain rfl : s = 0 := (Finsupp.degree_eq_zero_iff s).1 (by simpa using hs)
    have h1 : (1 : MvPolynomial (Fin 3) k) ∉ projectivePlaneCurve.ideal hF := by
      simpa using projectivePlaneCurve.pow_notMem_ideal hF hFG 0
    rw [functionField.mk_eq_mk_of_mul_eq _ _ _ (isHomogeneous_C _ c) (isHomogeneous_one _ _) h1
        (by simp),
      ← functionField.algebraMap_eq_mk]
    exact Subalgebra.algebraMap_mem _ c
  | succ r ih =>
    obtain ⟨u, hus, hu⟩ := Finsupp.exists_le_degree_eq s m (by rw [hs]; nlinarith)
    obtain ⟨t, rfl⟩ := le_iff_exists_add.mp hus
    have ht : t.degree = m * r := by
      rw [map_add, hu, mul_add_one] at hs
      omega
    have := mul_mem (ih t c ht) (Algebra.subset_adjoin ⟨u, hu, rfl⟩)
    rw [functionField.mk_mul_mk] at this
    rw [functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by
      rw [show monomial (u + t) c = monomial t c * monomial u 1 by
        rw [monomial_mul_monomial, add_comm, mul_one]])]
    exact this

variable (hF hG hFG) in
/-- **`A_G` is generated by the fractions `M / G`**, `M` a monomial of degree `m`: a monomial of
degree `m r` is a product of `r` monomials of degree `m`. -/
theorem awaySubalgebra_eq_adjoin :
    awaySubalgebra hF hG hFG = Algebra.adjoin k {z | ∃ (s : Fin 3 →₀ ℕ) (hs : s.degree = m),
      z = functionField.mk (isHomogeneous_monomial (1 : k) hs) hG
          (projectivePlaneCurve.notMem_ideal_of_not_dvd hF hFG)} := by
  refine le_antisymm ?_ (Algebra.adjoin_le ?_)
  · rintro _ ⟨r, H, hH, rfl⟩
    have hGI := projectivePlaneCurve.pow_notMem_ideal hF hFG r
    have key : ∀ p : MvPolynomial (Fin 3) k,
        functionField.mk (homogeneousComponent_isHomogeneous (m * r) p) (hG.pow r) hGI ∈
          Algebra.adjoin k {z | ∃ (s : Fin 3 →₀ ℕ) (hs : s.degree = m),
            z = functionField.mk (isHomogeneous_monomial (1 : k) hs) hG
              (projectivePlaneCurve.notMem_ideal_of_not_dvd hF hFG)} := by
      intro p
      induction p using MvPolynomial.induction_on' with
      | monomial u a =>
        by_cases hu : u.degree = m * r
        · rw [functionField.mk_eq_mk_of_mul_eq _ _ _ (isHomogeneous_monomial a hu) (hG.pow r) hGI
            (by rw [homogeneousComponent_of_mem (isHomogeneous_monomial a rfl)]; simp [hu])]
          exact mk_monomial_mem_adjoin (hFG := hFG) r u a hu
        · rw [functionField.mk_eq_mk_of_mul_eq _ _ _ (isHomogeneous_zero _ _ (m * r)) (hG.pow r)
            hGI (by
            rw [homogeneousComponent_of_mem (isHomogeneous_monomial a rfl)]; simp [Ne.symm hu]),
            (functionField.mk_eq_zero_iff _ _ _).2 (zero_mem _)]
          exact zero_mem _
      | add p q hp hq =>
        rw [functionField.mk_eq_mk_of_mul_eq _ _ _
            ((homogeneousComponent_isHomogeneous (m * r) p).add
            (homogeneousComponent_isHomogeneous (m * r) q)) (hG.pow r) hGI (by rw [map_add]),
          ← functionField.mk_add_mk_self (homogeneousComponent_isHomogeneous (m * r) p)
            (homogeneousComponent_isHomogeneous (m * r) q)]
        exact add_mem hp hq
    rw [functionField.mk_eq_mk_of_mul_eq _ _ _ (homogeneousComponent_isHomogeneous (m * r) H)
      (hG.pow r) hGI (by rw [homogeneousComponent_eq_self hH])]
    exact key H
  · rintro _ ⟨s, hs, rfl⟩
    exact ⟨1, monomial s 1, by rw [mul_one]; exact isHomogeneous_monomial 1 hs,
      functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by ring)⟩

/-- **`A_G` is a finitely generated `k`-algebra**, generated by the finitely many fractions
`M / G` with `M` a monomial of degree `m`. -/
instance finiteType_awaySubalgebra : Algebra.FiniteType k (awaySubalgebra hF hG hFG) := by
  rw [← Subalgebra.fg_iff_finiteType, awaySubalgebra_eq_adjoin]
  refine Subalgebra.fg_def.2 ⟨_, ?_, rfl⟩
  refine (Set.Finite.dependent_image (Finsupp.finite_of_degree_eq (σ := Fin 3) m)
    fun s (hs : s.degree = m) ↦ (functionField.mk (isHomogeneous_monomial (1 : k) hs) hG
      (projectivePlaneCurve.notMem_ideal_of_not_dvd hF hFG) : functionField hF)).subset ?_
  rintro _ ⟨s, hs, rfl⟩
  exact ⟨s, hs, rfl⟩

/-- For forms `f`, `g` of degree `e` with `F ∤ g` and `m = n + 1`, the fraction `f / g` is the
quotient of `f gⁿ / Gᵉ` and `gⁿ⁺¹ / Gᵉ`, two elements of `A_G`. -/
private theorem exists_mk_eq_div {n e : ℕ} (hG : G.IsHomogeneous (n + 1)) (hFG : ¬ F ∣ G)
    {f g : MvPolynomial (Fin 3) k} (hf : f.IsHomogeneous e) (hg : g.IsHomogeneous e)
    (hgI : g ∉ projectivePlaneCurve.ideal hF) :
    ∃ (hfg : (f * g ^ n).IsHomogeneous ((n + 1) * e))
      (hgg : (g ^ (n + 1)).IsHomogeneous ((n + 1) * e)),
      functionField.mk hf hg hgI * functionField.mk hgg (hG.pow e)
          (projectivePlaneCurve.pow_notMem_ideal hF hFG e) =
        functionField.mk hfg (hG.pow e)
          (projectivePlaneCurve.pow_notMem_ideal hF hFG e) := by
  refine ⟨by rw [show (n + 1) * e = e + e * n by ring]; exact hf.mul (hg.pow n),
    by rw [mul_comm]; exact hg.pow (n + 1), ?_⟩
  rw [functionField.mk_mul_mk]
  exact functionField.mk_eq_mk_of_mul_eq _ _ _ _ _ _ (by ring)

variable (hF hG hFG) in
/-- **`k(C)` is the fraction field of `A_G`**, for `m ≠ 0`: a fraction `f / g` of forms of degree
`e` is `(f gᵐ⁻¹ / Gᵉ) / (gᵐ / Gᵉ)`. -/
theorem isFractionRing_awaySubalgebra (hm : m ≠ 0) :
    IsFractionRing (awaySubalgebra hF hG hFG) (functionField hF) := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm
  refine IsFractionRing.of_field _ _ fun z ↦ ?_
  obtain ⟨e, f, g, hf, hg, hgI, rfl⟩ := functionField.exists_eq_mk z
  obtain ⟨hfg, hgg, h⟩ := exists_mk_eq_div hG hFG hf hg hgI
  have hGI := projectivePlaneCurve.pow_notMem_ideal hF hFG e
  refine ⟨⟨_, mk_mem_awaySubalgebra hfg (hG.pow e) hGI⟩,
    ⟨_, mk_mem_awaySubalgebra hgg (hG.pow e) hGI⟩, ?_⟩
  change _ = functionField.mk hfg _ _ / functionField.mk hgg _ _
  rw [← h, mul_div_cancel_right₀]
  exact functionField.mk_ne_zero _ _ _ (projectivePlaneCurve.pow_notMem_ideal hF
    (fun h ↦ hgI ((projectivePlaneCurve.mem_ideal_iff hF).2 h)) _)

variable (hF hG hFG) in
/-- The inclusion `A_G → 𝒪_P(C)` of the ring of the basic open set `D(G)` into the local ring at
a point `P ∈ D(G)`. -/
noncomputable def awaySubalgebraInclusion (hGP : eval P.1.rep G ≠ 0) :
    awaySubalgebra hF hG hFG →+* (localSubring hF P).toSubring :=
  Subring.inclusion (awaySubalgebra_le_localSubring hF hG hFG hGP)

@[simp]
theorem coe_awaySubalgebraInclusion (hGP : eval P.1.rep G ≠ 0) (z : awaySubalgebra hF hG hFG) :
    (awaySubalgebraInclusion hF hG hFG hGP z : functionField hF) = z :=
  (rfl)

/-- Every `z ∈ 𝒪_P(C)` is `a / s` with `a, s ∈ A_G` and `s` a unit of `𝒪_P(C)`, for
`G(P) ≠ 0` and `m = n + 1`. -/
private theorem exists_mul_eq_of_mem_localSubring {n : ℕ} (hG : G.IsHomogeneous (n + 1))
    (hGP : eval P.1.rep G ≠ 0) (z : (localSubring hF P).toSubring) :
    ∃ a s : awaySubalgebra hF hG hFG, IsUnit (awaySubalgebraInclusion hF hG hFG hGP s) ∧
      z * awaySubalgebraInclusion hF hG hFG hGP s = awaySubalgebraInclusion hF hG hFG hGP a := by
  obtain ⟨z, hz'⟩ := z
  obtain ⟨e, f, g, hf, hg, hgP, rfl⟩ := mem_localSubring_iff.1 hz'
  obtain ⟨hfg, hgg, h⟩ := exists_mk_eq_div hG hFG hf hg (notMem_of_eval_rep_ne_zero P.2 hg hgP)
  have hGI := projectivePlaneCurve.pow_notMem_ideal hF hFG e
  have hggP : eval P.1.rep (g ^ (n + 1)) ≠ 0 := by simpa using pow_ne_zero (n + 1) hgP
  refine ⟨⟨_, mk_mem_awaySubalgebra hfg (hG.pow e) hGI⟩,
    ⟨_, mk_mem_awaySubalgebra hgg (hG.pow e) hGI⟩, ?_, Subtype.ext h⟩
  refine IsUnit.of_mul_eq_one ⟨functionField.mk (hG.pow e) hgg
    (notMem_of_eval_rep_ne_zero P.2 hgg hggP),
    mem_localSubring_iff.2 ⟨_, _, _, _, _, hggP, rfl⟩⟩ (Subtype.ext ?_)
  exact functionField.mk_mul_mk_swap _ _ _ _

variable (hF hG hFG) in
/-- **The local ring at a point of `D(G)` is a localization of `A_G`**: for `m ≠ 0` and
`G(P) ≠ 0`, `𝒪_P(C)` is the localization of `A_G` at the prime of the functions vanishing at `P`,
the preimage of the maximal ideal of `𝒪_P(C)`. -/
theorem isLocalization_localSubring_awaySubalgebra (hm : m ≠ 0) (hGP : eval P.1.rep G ≠ 0) :
    letI := (awaySubalgebraInclusion hF hG hFG hGP).toAlgebra
    IsLocalization.AtPrime (localSubring hF P).toSubring
      ((IsLocalRing.maximalIdeal (localSubring hF P).toSubring).comap
        (awaySubalgebraInclusion hF hG hFG hGP)) := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm
  refine (@isLocalization_iff _ _ _ _ _ (awaySubalgebraInclusion hF hG hFG hGP).toAlgebra).2
    ⟨fun y ↦ IsLocalRing.notMem_maximalIdeal.1 y.2, fun z ↦ ?_, fun {x y} h ↦ ⟨1, ?_⟩⟩
  · have hz := exists_mul_eq_of_mem_localSubring (hFG := hFG) hG hGP ⟨z.1, z.2⟩
    obtain ⟨a, s, hs, h⟩ := hz
    have hs' : s ∈ ((IsLocalRing.maximalIdeal (localSubring hF P).toSubring).comap
        (awaySubalgebraInclusion hF hG hFG hGP)).primeCompl :=
      fun hmem ↦ (IsLocalRing.mem_maximalIdeal _).1 hmem hs
    exact ⟨(a, ⟨s, hs'⟩), h⟩
  · rw [Submonoid.coe_one, one_mul, one_mul]
    have h' := congrArg (Subtype.val : (localSubring hF P).toSubring → functionField hF) h
    exact Subtype.ext h'

end PlaneCurves.Projective

end
