module

public import Mathlib.RingTheory.Ideal.Span
public import PlaneCurves.RingTheory.MvPolynomial.Hessian

/-!
# The Hessian of a plane form

For a form `F` of degree `n` in the three variables `X, Y, Z` over a commutative ring, these are
the identities of [Fulton2008], Problem 5.23, that relate the Hessian determinant
`H = det (Fᵢⱼ)` to `F` and its first and second partial derivatives, where
`Fᵢ = ∂F/∂Xᵢ` and `Fᵢⱼ = ∂²F/∂Xᵢ∂Xⱼ`.

Multiplying by `Z²` and expanding a bordered determinant gives
`Z² H = (n - 1) (n F (F₀₀ F₁₁ - F₀₁²) - (n - 1) (F₁² F₀₀ + F₀² F₁₁ - 2 F₀ F₁ F₀₁))`.
In the affine chart `Z = 1`, with `f` the dehomogenization of `F`, this becomes
`h = n (n - 1) f (f₀₀ f₁₁ - f₀₁²) - (n - 1)² g` for `h` the dehomogenized Hessian and
`g = f₁² f₀₀ + f₀² f₁₁ - 2 f₀ f₁ f₀₁`. In particular `h ≡ -(n - 1)² g` modulo `f`, which is the
form in which the Hessian criterion for flexes uses it. All of this holds over any commutative
ring and for every degree `n`.

## Main results

* `MvPolynomial.IsHomogeneous.sq_X_two_mul_det_hessian`: the identity for `Z² H`.
* `MvPolynomial.IsHomogeneous.dehomogenize_det_hessian`: the identity for `h` in the chart
  `Z = 1`.
* `MvPolynomial.IsHomogeneous.dehomogenize_det_hessian_add_mem_span`: `h + (n - 1)² g` lies in
  the ideal generated by `f`.

## References

* [W. Fulton, *Algebraic Curves: An Introduction to Algebraic Geometry*][Fulton2008],
  §5.3, Problem 5.23, p. 59
-/

public section

namespace MvPolynomial

open Matrix

variable {R : Type*} [CommRing R] {F : MvPolynomial (Fin 3) R} {n : ℕ}

/-- **The plane Hessian identity**: for a form `F` of degree `n` in three variables, with
`Fᵢ = ∂F/∂Xᵢ` and `Fᵢⱼ = ∂²F/∂Xᵢ∂Xⱼ`,
`Z² H = (n - 1) (n F (F₀₀ F₁₁ - F₀₁²) - (n - 1) (F₁² F₀₀ + F₀² F₁₁ - 2 F₀ F₁ F₀₁))`, for `H` the
Hessian determinant of `F` and `Z = X 2`. -/
theorem IsHomogeneous.sq_X_two_mul_det_hessian (hF : F.IsHomogeneous n) :
    X 2 ^ 2 * (TauCeti.hessian pderiv F).det =
      ((n - 1 : ℕ) : MvPolynomial (Fin 3) R) *
        ((n : MvPolynomial (Fin 3) R) * F *
            (pderiv 0 (pderiv 0 F) * pderiv 1 (pderiv 1 F) - pderiv 0 (pderiv 1 F) ^ 2) -
          ((n - 1 : ℕ) : MvPolynomial (Fin 3) R) *
            (pderiv 1 F ^ 2 * pderiv 0 (pderiv 0 F) + pderiv 0 F ^ 2 * pderiv 1 (pderiv 1 F) -
              2 * pderiv 0 F * pderiv 1 F * pderiv 0 (pderiv 1 F))) := by
  rw [hF.sq_X_mul_det_hessian 2, det_fin_three]
  simp only [updateRow_apply, updateCol_apply, TauCeti.hessian_apply, nsmul_eq_mul,
    Fin.reduceEq, ↓reduceIte]
  rw [pderiv_comm (i := (1 : Fin 3)) (j := 0)]
  ring

/-- In the chart `Z = 1` of the plane, the partial derivative along the `j`-th affine
coordinate commutes with dehomogenization. -/
private theorem dehomogenize_two_pderiv (p : MvPolynomial (Fin 3) R) (j : Fin 2) :
    TauCeti.dehomogenize 2 (pderiv j.castSucc p) = pderiv j (TauCeti.dehomogenize 2 p) := by
  rw [TauCeti.pderiv_dehomogenize, show (2 : Fin 3) = Fin.last 2 from rfl, Fin.succAbove_last]

/-- **The Hessian in the chart `Z = 1`**: for a form `F` of degree `n` in three variables, with
`f` its dehomogenization at `Z`, `fᵢ = ∂f/∂xᵢ` and `fᵢⱼ = ∂²f/∂xᵢ∂xⱼ`, the dehomogenized Hessian
determinant is `n (n - 1) f (f₀₀ f₁₁ - f₀₁²) - (n - 1)² (f₁² f₀₀ + f₀² f₁₁ - 2 f₀ f₁ f₀₁)`. -/
theorem IsHomogeneous.dehomogenize_det_hessian (hF : F.IsHomogeneous n) :
    TauCeti.dehomogenize 2 (TauCeti.hessian pderiv F).det =
      ((n * (n - 1) : ℕ) : MvPolynomial (Fin 2) R) * TauCeti.dehomogenize 2 F *
          (pderiv 0 (pderiv 0 (TauCeti.dehomogenize 2 F)) *
              pderiv 1 (pderiv 1 (TauCeti.dehomogenize 2 F)) -
            pderiv 0 (pderiv 1 (TauCeti.dehomogenize 2 F)) ^ 2) -
        ((n - 1 : ℕ) : MvPolynomial (Fin 2) R) ^ 2 *
          (pderiv 1 (TauCeti.dehomogenize 2 F) ^ 2 *
              pderiv 0 (pderiv 0 (TauCeti.dehomogenize 2 F)) +
            pderiv 0 (TauCeti.dehomogenize 2 F) ^ 2 *
              pderiv 1 (pderiv 1 (TauCeti.dehomogenize 2 F)) -
            2 * pderiv 0 (TauCeti.dehomogenize 2 F) * pderiv 1 (TauCeti.dehomogenize 2 F) *
              pderiv 0 (pderiv 1 (TauCeti.dehomogenize 2 F))) := by
  have h0 : ∀ p : MvPolynomial (Fin 3) R,
      TauCeti.dehomogenize 2 (pderiv 0 p) = pderiv 0 (TauCeti.dehomogenize 2 p) :=
    fun p ↦ dehomogenize_two_pderiv p 0
  have h1 : ∀ p : MvPolynomial (Fin 3) R,
      TauCeti.dehomogenize 2 (pderiv 1 p) = pderiv 1 (TauCeti.dehomogenize 2 p) :=
    fun p ↦ dehomogenize_two_pderiv p 1
  have key := congrArg (TauCeti.dehomogenize 2) hF.sq_X_two_mul_det_hessian
  simp only [map_mul, map_add, map_sub, map_pow, map_natCast, map_ofNat, TauCeti.dehomogenize_X,
    Fin.insertNth_apply_same, one_pow, one_mul, h0, h1] at key
  rw [key]
  push_cast
  ring

/-- **The Hessian modulo the curve**: for a form `F` of degree `n` in three variables, with `f`
its dehomogenization at `Z`, the dehomogenized Hessian determinant `h` satisfies
`h + (n - 1)² (f₁² f₀₀ + f₀² f₁₁ - 2 f₀ f₁ f₀₁) ∈ (f)`. -/
theorem IsHomogeneous.dehomogenize_det_hessian_add_mem_span (hF : F.IsHomogeneous n) :
    TauCeti.dehomogenize 2 (TauCeti.hessian pderiv F).det +
        ((n - 1 : ℕ) : MvPolynomial (Fin 2) R) ^ 2 *
          (pderiv 1 (TauCeti.dehomogenize 2 F) ^ 2 *
              pderiv 0 (pderiv 0 (TauCeti.dehomogenize 2 F)) +
            pderiv 0 (TauCeti.dehomogenize 2 F) ^ 2 *
              pderiv 1 (pderiv 1 (TauCeti.dehomogenize 2 F)) -
            2 * pderiv 0 (TauCeti.dehomogenize 2 F) * pderiv 1 (TauCeti.dehomogenize 2 F) *
              pderiv 0 (pderiv 1 (TauCeti.dehomogenize 2 F))) ∈
      Ideal.span {TauCeti.dehomogenize 2 F} := by
  rw [hF.dehomogenize_det_hessian, sub_add_cancel, Ideal.mem_span_singleton]
  exact ((dvd_refl _).mul_left _).mul_right _

end MvPolynomial
