/-!
# Intersection numbers of projective plane curves

Let `F` and `G` be forms in `k[X, Y, Z]` and `P` a point of `ℙ²`. Fulton (§5.1) defines the
intersection number `I(P, F ∩ G)` as `dim_k 𝒪_P(ℙ²) ⧸ (F_*, G_*)`, where `F_* = F / L^{deg F}` and
`G_* = G / L^{deg G}` for a linear form `L` with `L(P) ≠ 0`. Here it is the length of
`𝒪_P(ℙ²) ⧸ localIdeal P (F, G)`, which needs no choice of `L` and is defined for all polynomials;
for forms the ideal is `(F_*, G_*)` (`localIdeal_span_pair`). In every standard chart
`Xᵢ ≠ 0` containing `P` it is the affine intersection number of the dehomogenizations
(`intersectionNumber_eq_affine`), and the properties (1)–(4) and (7) of §5.1 follow from the
affine ones of §3.3.

## Main definitions

* `PlaneCurves.Projective.intersectionNumber P F G : ℕ∞`: the intersection number
  `I(P, F ∩ G)`.

## Main results

* `intersectionNumber_eq_affine`: `I(P, F ∩ G)` is the affine intersection number of `F_(i)` and
  `G_(i)` at the chart point of `P`, for every chart `Xᵢ ≠ 0` containing `P`.
* `intersectionNumber_ne_top_iff`, property (1): `I(P, F ∩ G)` is finite iff `F` and `G` have no
  common component through `P`. In a chart this is `intersectProperlyAt_dehomogenize_iff`.
* `intersectionNumber_eq_zero_iff`, property (2): `I(P, F ∩ G) = 0` iff `P ∉ V(F) ∩ V(G)`; and
  `intersectionNumber_mul_left_of_eval_ne_zero`: components not through `P` do not count.
* `intersectionNumber_linearSubst`, property (3): invariance under projective changes of
  coordinates. The local equations correspond (`associated_linearSubstEquiv_localEquation`).
* `intersectionNumber_comm`, property (4): symmetry.
* `intersectionNumber_add_mul`, property (7): `I(P, F ∩ (G + A F)) = I(P, F ∩ G)`.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §5.1
-/

public section

namespace PlaneCurves.Projective

open MvPolynomial Projectivization TauCeti PlaneCurves.ProjectiveSpace HomogeneousLocalization
open scoped LinearAlgebra.Projectivization

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type*} [Field k] {P : ℙ k (Fin 3 → k)} {F G F' G' : MvPolynomial (Fin 3) k}
  {d e : ℕ}

/-- The intersection number `I(P, F ∩ G)` of two projective plane curves at a point `P` of `ℙ²`:
the length of `𝒪_P(ℙ²) ⧸ (F, G) 𝒪_P(ℙ²)` over the local ring `𝒪_P(ℙ²)`. For forms `F` and `G`
the ideal is generated by the local equations `F_*` and `G_*` (`localIdeal_span_pair`), and the
intersection number is the affine one in any chart containing `P`
(`intersectionNumber_eq_affine`). -/
noncomputable def intersectionNumber (P : ℙ k (Fin 3 → k)) (F G : MvPolynomial (Fin 3) k) : ℕ∞ :=
  Module.length (localRing P) (localRing P ⧸ localIdeal P (Ideal.span {F, G}))

theorem intersectionNumber_def (P : ℙ k (Fin 3 → k)) (F G : MvPolynomial (Fin 3) k) :
    intersectionNumber P F G =
      Module.length (localRing P) (localRing P ⧸ localIdeal P (Ideal.span {F, G})) :=
  (rfl)

/-- The intersection number depends only on the ideal `(F, G)` of `k[X, Y, Z]`. -/
theorem intersectionNumber_congr (h : Ideal.span {F, G} = Ideal.span {F', G'}) :
    intersectionNumber P F G = intersectionNumber P F' G' := by
  rw [intersectionNumber_def, intersectionNumber_def, h]

/-- **Property (4)**: the intersection number is symmetric, `I(P, F ∩ G) = I(P, G ∩ F)`. -/
theorem intersectionNumber_comm (P : ℙ k (Fin 3 → k)) (F G : MvPolynomial (Fin 3) k) :
    intersectionNumber P F G = intersectionNumber P G F :=
  intersectionNumber_congr (by rw [Set.pair_comm])

/-- **Property (7)**: `I(P, F ∩ (G + A F)) = I(P, F ∩ G)`. This holds for every polynomial `A`;
for forms `F` and `G`, it is Fulton's statement when `A` is a form of degree `deg G - deg F`, so
that `G + A F` is a form. -/
@[simp]
theorem intersectionNumber_add_mul (P : ℙ k (Fin 3 → k)) (F G A : MvPolynomial (Fin 3) k) :
    intersectionNumber P F (G + A * F) = intersectionNumber P F G :=
  intersectionNumber_congr (Ideal.span_pair_add_mul_left _ _ _)

/-- For forms, `I(P, F ∩ G)` is the length of `𝒪_P(ℙ²) ⧸ (F_*, G_*)`, Fulton's definition. -/
theorem intersectionNumber_eq_length_localEquation (hF : F.IsHomogeneous d)
    (hG : G.IsHomogeneous e) :
    intersectionNumber P F G = Module.length (localRing P)
      (localRing P ⧸ Ideal.span {localEquation P F, localEquation P G}) := by
  rw [intersectionNumber_def, localIdeal_span_pair hF hG]

/-- An isomorphism of rings carrying `a` and `b` to associates of `a'` and `b'` identifies the
lengths of `R ⧸ (a, b)` and `S ⧸ (a', b')`. -/
private theorem length_quotient_span_pair_eq_of_ringEquiv {R S : Type*} [CommRing R]
    [CommRing S] (φ : R ≃+* S) {a b : R} {a' b' : S} (ha : Associated (φ a) a')
    (hb : Associated (φ b) b') :
    Module.length S (S ⧸ Ideal.span {a', b'}) = Module.length R (R ⧸ Ideal.span {a, b}) := by
  obtain ⟨u, rfl⟩ := ha
  obtain ⟨v, rfl⟩ := hb
  rw [Ideal.span_insert, Ideal.span_singleton_mul_right_unit u.isUnit,
    Ideal.span_singleton_mul_right_unit v.isUnit, ← Ideal.span_insert, ← Set.image_pair,
    ← Ideal.map_span, Ideal.length_quotient_map_of_surjective _ φ.surjective,
    (RingHom.injective_iff_ker_eq_bot _).1 φ.injective, sup_bot_eq]

/-- **The intersection number in a chart.** For forms `F` and `G` and every standard chart
`Xᵢ ≠ 0` containing `P`, `I(P, F ∩ G)` is the affine intersection number of the
dehomogenizations `F_(i)` and `G_(i)` at the chart point of `P`. -/
theorem intersectionNumber_eq_affine (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e)
    {i : Fin 3} (hP : P ∈ affineOpen i) :
    intersectionNumber P F G =
      Affine.intersectionNumber (affineChart i P) (dehomogenize i F) (dehomogenize i G) := by
  rw [intersectionNumber_eq_length_localEquation hF hG, Affine.intersectionNumber_def]
  exact (length_quotient_span_pair_eq_of_ringEquiv (localRing.chartEquiv i hP).toRingEquiv
    (associated_chartEquiv_localEquation hF hP) (associated_chartEquiv_localEquation hG hP)).symm
/-! ### Vanishing -/

/-- **Property (2)**: for forms `F` and `G`, `I(P, F ∩ G) = 0` iff `P` does not lie on both
curves. -/
theorem intersectionNumber_eq_zero_iff (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e) :
    intersectionNumber P F G = 0 ↔ eval P.rep F ≠ 0 ∨ eval P.rep G ≠ 0 := by
  obtain ⟨i, hP⟩ := exists_mem_affineOpen P
  rw [intersectionNumber_eq_affine hF hG hP, Affine.intersectionNumber_eq_zero_iff, Ne, Ne,
    eval_affineChart_dehomogenize_eq_zero_iff hP hF,
    eval_affineChart_dehomogenize_eq_zero_iff hP hG]

/-- **Property (2)**, second part: components not through `P` do not count,
`I(P, F U ∩ G) = I(P, F ∩ G)` for a form `U` with `U(P) ≠ 0`. -/
theorem intersectionNumber_mul_left_of_eval_ne_zero {U : MvPolynomial (Fin 3) k} {m : ℕ}
    (hF : F.IsHomogeneous d) (hU : U.IsHomogeneous m) (hG : G.IsHomogeneous e)
    (hUP : eval P.rep U ≠ 0) :
    intersectionNumber P (F * U) G = intersectionNumber P F G := by
  obtain ⟨i, hP⟩ := exists_mem_affineOpen P
  rw [intersectionNumber_eq_affine (hF.mul hU) hG hP, intersectionNumber_eq_affine hF hG hP,
    map_mul, Affine.intersectionNumber_mul_left_of_eval_ne_zero]
  rwa [Ne, eval_affineChart_dehomogenize_eq_zero_iff hP hU]

/-- `I(P, F ∩ G U) = I(P, F ∩ G)` for a form `U` with `U(P) ≠ 0`. -/
theorem intersectionNumber_mul_right_of_eval_ne_zero {U : MvPolynomial (Fin 3) k} {m : ℕ}
    (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e) (hU : U.IsHomogeneous m)
    (hUP : eval P.rep U ≠ 0) :
    intersectionNumber P F (G * U) = intersectionNumber P F G := by
  rw [intersectionNumber_comm, intersectionNumber_mul_left_of_eval_ne_zero hG hU hF hUP,
    intersectionNumber_comm]

/-! ### Finiteness -/

/-- For forms `F` and `G` and a chart `Xᵢ ≠ 0` containing `P`, the dehomogenizations `F_(i)` and
`G_(i)` intersect properly at the chart point of `P` iff no irreducible common factor of `F` and
`G` vanishes at `P`, that is, iff `F` and `G` have no common component through `P`. -/
theorem intersectProperlyAt_dehomogenize_iff (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e)
    {i : Fin 3} (hP : P ∈ affineOpen i) :
    Affine.IntersectProperlyAt (dehomogenize i F) (dehomogenize i G) (affineChart i P) ↔
      ∀ H : MvPolynomial (Fin 3) k, Irreducible H → H ∣ F → H ∣ G → eval P.rep H ≠ 0 := by
  rw [Affine.intersectProperlyAt_def]
  refine ⟨fun h H hH hHF hHG hHP ↦ ?_, fun h f hf hfF hfG hfP ↦ ?_⟩
  · -- `H` is a form not divisible by `Xᵢ`, so `H_(i)` is an irreducible common factor
    have hFG : F ≠ 0 ∨ G ≠ 0 := by
      by_contra! h0
      obtain ⟨rfl, rfl⟩ := h0
      exact (Affine.intersectProperlyAt_def.2 h).ne_zero_left (by simp) (by simp)
    have hHm : H.IsHomogeneous H.totalDegree := by
      rcases hFG with hF0 | hG0
      · obtain ⟨K, rfl⟩ := hHF
        exact hF.of_mul_left (right_ne_zero_of_mul hF0)
      · obtain ⟨K, rfl⟩ := hHG
        exact hG.of_mul_left (right_ne_zero_of_mul hG0)
    have hX : ¬ X i ∣ H := by
      rintro ⟨c, rfl⟩
      have hc : IsUnit c := (hH.isUnit_or_isUnit rfl).resolve_left
        fun hu ↦ (hu.map (eval 0)).ne_zero (by simp)
      rw [eval_mul, eval_X] at hHP
      exact (hc.map (eval P.rep)).ne_zero
        ((mul_eq_zero.1 hHP).resolve_left ((mem_affineOpen_iff i P).1 hP))
    exact h _ ((irreducible_dehomogenize_iff hHm hX).2 hH) (map_dvd _ hHF) (map_dvd _ hHG)
      ((eval_affineChart_dehomogenize_eq_zero_iff hP hHm).2 hHP)
  · -- the homogenization `f*` is an irreducible common factor of `F` and `G`
    refine h _ (irreducible_homogenize_totalDegree hf)
      (homogenize_totalDegree_dvd_of_dvd_dehomogenize hF hfF)
      (homogenize_totalDegree_dvd_of_dvd_dehomogenize hG hfG) ?_
    rwa [← eval_affineChart_dehomogenize_eq_zero_iff hP (isHomogeneous_homogenize i _ f),
      dehomogenize_homogenize_totalDegree]

/-- **Property (1)**: for forms `F` and `G`, `I(P, F ∩ G)` is finite iff `F` and `G` have no
common component through `P`, that is, iff no irreducible common factor of `F` and `G` vanishes
at `P`. -/
theorem intersectionNumber_ne_top_iff (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e) :
    intersectionNumber P F G ≠ ⊤ ↔
      ∀ H : MvPolynomial (Fin 3) k, Irreducible H → H ∣ F → H ∣ G → eval P.rep H ≠ 0 := by
  obtain ⟨i, hP⟩ := exists_mem_affineOpen P
  rw [intersectionNumber_eq_affine hF hG hP, Affine.intersectionNumber_ne_top_iff,
    intersectProperlyAt_dehomogenize_iff hF hG hP]

/-- Relatively prime forms have finite intersection numbers. -/
theorem intersectionNumber_ne_top_of_isRelPrime (hF : F.IsHomogeneous d)
    (hG : G.IsHomogeneous e) (h : IsRelPrime F G) : intersectionNumber P F G ≠ ⊤ :=
  (intersectionNumber_ne_top_iff hF hG).2 fun _ hH hHF hHG _ ↦ hH.not_isUnit (h hHF hHG)

/-! ### Changes of coordinates -/

/-- For `T(Q) = P`, the isomorphism `𝒪_P(ℙⁿ) ≅ 𝒪_Q(ℙⁿ)` sends the local equation `F_*` of a form
`F` at `P` to the local equation `(F^T)_*` at `Q`, up to a unit. -/
theorem associated_linearSubstEquiv_localEquation {n : ℕ} {F : MvPolynomial (Fin (n + 1)) k}
    (hF : F.IsHomogeneous d) (M : GL (Fin (n + 1)) k) {P Q : ℙ k (Fin (n + 1) → k)}
    (hQP : map M.1.mulVecLin (Matrix.mulVec_injective_of_isUnit M.isUnit) Q = P) :
    Associated (localRing.linearSubstEquiv hQP (localEquation P F))
      (localEquation Q (linearSubst M.1 F)) := by
  obtain ⟨j, hj⟩ := exists_mem_affineOpen P
  have h := (associated_localEquation_mk (P := P) ⟨d, ⟨F, (mem_homogeneousSubmodule _ _).2 hF⟩,
    ⟨X j ^ d, (mem_homogeneousSubmodule _ _).2 (isHomogeneous_X_pow _ d)⟩,
      pow_mem (X_mem_primeCompl_pointIdeal hj) d⟩).map (localRing.linearSubstEquiv hQP)
  rw [localRing.linearSubstEquiv_mk] at h
  exact h.trans (associated_localEquation_mk _).symm

/-- **Property (3)**: intersection numbers are invariant under projective changes of
coordinates. For forms `F` and `G`, an invertible matrix `M` with projective change of
coordinates `T`, and `F^T = F(M X)`, `I(Q, F^T ∩ G^T) = I(T(Q), F ∩ G)`. -/
theorem intersectionNumber_linearSubst (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e)
    (M : GL (Fin 3) k) (Q : ℙ k (Fin 3 → k)) :
    intersectionNumber Q (linearSubst M.1 F) (linearSubst M.1 G) =
      intersectionNumber (map M.1.mulVecLin (Matrix.mulVec_injective_of_isUnit M.isUnit) Q)
        F G := by
  rw [intersectionNumber_eq_length_localEquation (hF.linearSubst _) (hG.linearSubst _),
    intersectionNumber_eq_length_localEquation hF hG]
  exact length_quotient_span_pair_eq_of_ringEquiv (localRing.linearSubstEquiv rfl).toRingEquiv
    (associated_linearSubstEquiv_localEquation hF M rfl)
    (associated_linearSubstEquiv_localEquation hG M rfl)

end PlaneCurves.Projective

