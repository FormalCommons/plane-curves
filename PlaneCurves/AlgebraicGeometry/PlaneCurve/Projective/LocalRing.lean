module

public import PlaneCurves.AlgebraicGeometry.ProjectiveSpace.ChartLocalRing

/-!
# Local equations and localized ideals in `𝒪_P(ℙⁿ)`

Let `P` be a point of `ℙⁿ` over a field `k`. A form `F` of degree `d` is not an element of the
local ring `𝒪_P(ℙⁿ)`, but `F / L^d` is, for every linear form `L` with `L(P) ≠ 0`, and two such
choices differ by the unit `L'^d / L^d`. Fulton writes `F_*` for this element (§5.1); it is
determined by `F` up to a unit.

This file fixes the choice: `localEquation P F` is `F / Xᵢᵈ` for a coordinate `Xᵢ` with
`Xᵢ(P) ≠ 0`, chosen once for `P`, so that `localEquation P` is a `k`-algebra hom from the
polynomial ring to `𝒪_P(ℙⁿ)` (through the chart isomorphism, it is `F ↦ F(…, 1, …)` with `1` in
place `i`). For a form `F`, every fraction `F / s` with `s(P) ≠ 0` homogeneous of the same degree
is `localEquation P F` times a unit (`associated_localEquation_mk`).

For an ideal `I` of `k[X₀, …, Xₙ]`, the localized ideal `localIdeal P I` is the ideal of
`𝒪_P(ℙⁿ)` of the fractions `a / s` with `a ∈ I` and `s ∉ I(P)` forms of the same degree. It needs
no choice of `L`, and for forms `F` and `G` it is the ideal generated by `F_*` and `G_*`
(`localIdeal_span_pair`). The projective intersection number is defined with it.

## Main definitions

* `PlaneCurves.Projective.localEquation P : k[X₀, …, Xₙ] →ₐ[k] 𝒪_P(ℙⁿ)`: the local equation
  `F_* = F / Xᵢᵈ` of a form `F` of degree `d`, for a chosen `i` with `Xᵢ(P) ≠ 0`.
* `PlaneCurves.Projective.localIdeal P I : Ideal 𝒪_P(ℙⁿ)`: the fractions `a / s` with `a ∈ I`.

## Main results

* `associated_localEquation_mk`: `F / s` is `F_*` up to a unit, for every admissible `s`.
* `isUnit_localEquation_iff`: `F_*` is a unit iff `F(P) ≠ 0`.
* `associated_chartEquiv_localEquation`: in every chart `Xᵢ ≠ 0` containing `P`, the chart
  isomorphism sends `F_*` to the dehomogenization `F(…, 1, …)` up to a unit.
* `mem_localIdeal_iff`, `localEquation_mem_localIdeal`, `localIdeal_mono`, `localIdeal_top`.
* `localIdeal_eq_map`: for a homogeneous ideal `I`, `localIdeal P I` is the image of `I` under
  `localEquation P`.
* `localIdeal_span`, `localIdeal_span_singleton`, `localIdeal_span_pair`: the localized ideal
  of the ideal generated by forms is generated by their local equations.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §5.1
-/

public section

namespace PlaneCurves.Projective

open MvPolynomial Projectivization TauCeti PlaneCurves.ProjectiveSpace HomogeneousLocalization
open scoped LinearAlgebra.Projectivization

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type*} [Field k] {n : ℕ} {P : ℙ k (Fin (n + 1) → k)}
  {F G : MvPolynomial (Fin (n + 1)) k} {d e : ℕ}

/-! ### Local equations -/

/-- The local equation `F_*` of a polynomial `F` at a point `P` of `ℙⁿ`: for a form `F` of
degree `d` it is the fraction `F / Xᵢᵈ` in `𝒪_P(ℙⁿ)`, for a coordinate `Xᵢ` with `Xᵢ(P) ≠ 0`
chosen once for `P`. Through the chart isomorphism `𝒪_P(ℙⁿ) ≅ 𝒪_{φᵢ(P)}(𝔸ⁿ)` it is the
dehomogenization `F(X₀, …, 1, …, Xₙ)`, which makes `localEquation P` a `k`-algebra hom. For a form,
any other admissible denominator changes it by a unit (`associated_localEquation_mk`). -/
noncomputable def localEquation (P : ℙ k (Fin (n + 1) → k)) :
    MvPolynomial (Fin (n + 1)) k →ₐ[k] localRing P :=
  (localRing.chartEquiv _ (exists_mem_affineOpen P).choose_spec).symm.toAlgHom.comp
    ((IsScalarTower.toAlgHom k _ _).comp (dehomogenize (exists_mem_affineOpen P).choose))

theorem localEquation_def (P : ℙ k (Fin (n + 1) → k)) :
    localEquation P =
      (localRing.chartEquiv _ (exists_mem_affineOpen P).choose_spec).symm.toAlgHom.comp
        ((IsScalarTower.toAlgHom k _ _).comp (dehomogenize (exists_mem_affineOpen P).choose)) :=
  (rfl)

/-- The local equation of a form `F` of degree `d` is the fraction `F / Xᵢᵈ`, for the coordinate
`Xᵢ` that `localEquation` chooses. -/
private theorem localEquation_eq_mk (hF : F.IsHomogeneous d) :
    localEquation P F = mk ⟨d, ⟨F, (mem_homogeneousSubmodule _ _).2 hF⟩,
      ⟨X (exists_mem_affineOpen P).choose ^ d,
        (mem_homogeneousSubmodule _ _).2 (isHomogeneous_X_pow _ d)⟩,
      pow_mem (X_mem_primeCompl_pointIdeal (exists_mem_affineOpen P).choose_spec) d⟩ := by
  rw [localEquation_def, AlgHom.comp_apply, AlgHom.comp_apply, AlgEquiv.toAlgHom_apply,
    AlgEquiv.symm_apply_eq, localRing.chartEquiv_mk_of_den_eq _ _ rfl]
  rfl

/-- For forms `s` and `t` of the same degree with `s(P) ≠ 0` and `t(P) ≠ 0`, the fraction `t / s`
is a unit of `𝒪_P(ℙⁿ)`. -/
private theorem isUnit_mk_of_num_mem_primeCompl
    (c : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k) (pointIdeal P).toIdeal.primeCompl)
    (hc : (c.num : MvPolynomial (Fin (n + 1)) k) ∈ (pointIdeal P).toIdeal.primeCompl) :
    IsUnit (mk c) := by
  rw [localRing.isUnit_iff_evalAt_ne_zero, localRing.evalAt_mk_rep]
  exact div_ne_zero (by simpa using localRing.eval_rep_ne_zero c.num.2 hc)
    (by simpa using localRing.eval_rep_ne_zero c.den.2 c.den_mem)

/-- **`F_*` is well defined up to a unit.** For a fraction `F / s` of forms of the same degree
with `s(P) ≠ 0`, the local equation `F_*` and `F / s` are associated in `𝒪_P(ℙⁿ)`: replacing
`Xᵢᵈ` by `s`, for instance by `Lᵈ` for a linear form `L` with `L(P) ≠ 0`, multiplies `F_*` by a
unit. -/
theorem associated_localEquation_mk
    (c : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k) (pointIdeal P).toIdeal.primeCompl) :
    Associated (localEquation P c.num) (mk c) := by
  set i := (exists_mem_affineOpen P).choose
  have hi : P ∈ affineOpen i := (exists_mem_affineOpen P).choose_spec
  have hXd := pow_mem (X_mem_primeCompl_pointIdeal hi) c.deg
  set u : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k)
    (pointIdeal P).toIdeal.primeCompl :=
    ⟨c.deg, ⟨X i ^ c.deg, (mem_homogeneousSubmodule _ _).2 (isHomogeneous_X_pow _ _)⟩, c.den,
      c.den_mem⟩
  refine ⟨(isUnit_mk_of_num_mem_primeCompl u hXd).unit, ?_⟩
  rw [IsUnit.unit_spec, localEquation_eq_mk ((mem_homogeneousSubmodule _ _).1 c.num.2),
    ext_iff_val, val_mul, val_mk, val_mk, val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  exact ⟨1, by simp [u]; ring⟩

/-- The local equation of a form `F` is a unit of `𝒪_P(ℙⁿ)` iff `F` does not vanish at `P`. -/
theorem isUnit_localEquation_iff (hF : F.IsHomogeneous d) :
    IsUnit (localEquation P F) ↔ eval P.rep F ≠ 0 := by
  have hi : P ∈ affineOpen (exists_mem_affineOpen P).choose :=
    (exists_mem_affineOpen P).choose_spec
  rw [localEquation_eq_mk hF, localRing.isUnit_iff_evalAt_ne_zero, localRing.evalAt_mk_rep]
  have := localRing.eval_rep_ne_zero ((mem_homogeneousSubmodule _ _).2 (isHomogeneous_X_pow _ d))
    (pow_mem (X_mem_primeCompl_pointIdeal hi) d)
  rw [aeval_eq_eval] at this
  exact div_ne_zero_iff.trans (and_iff_left this)

/-- **Local equations in a chart.** For a form `F` and every chart `Xᵢ ≠ 0` containing `P`, the
chart isomorphism `𝒪_P(ℙⁿ) ≅ 𝒪_{φᵢ(P)}(𝔸ⁿ)` sends the local equation `F_*` to the
dehomogenization `F(X₀, …, 1, …, Xₙ)`, up to a unit. -/
theorem associated_chartEquiv_localEquation (hF : F.IsHomogeneous d) {i : Fin (n + 1)}
    (hP : P ∈ affineOpen i) :
    Associated (localRing.chartEquiv i hP (localEquation P F))
      (algebraMap _ (AffineSpace.localRing k (affineChart i P)) (dehomogenize i F)) := by
  have h := (associated_localEquation_mk (P := P) ⟨d, ⟨F, (mem_homogeneousSubmodule _ _).2 hF⟩,
    ⟨X i ^ d, (mem_homogeneousSubmodule _ _).2 (isHomogeneous_X_pow _ d)⟩,
      pow_mem (X_mem_primeCompl_pointIdeal hP) d⟩).map (localRing.chartEquiv i hP)
  rwa [localRing.chartEquiv_mk_of_den_eq _ _ rfl] at h

/-! ### Localized ideals -/

variable (P) in
/-- The localized ideal `I 𝒪_P(ℙⁿ)` of an ideal `I` of `k[X₀, …, Xₙ]`: the fractions `a / s` in
`𝒪_P(ℙⁿ)` with `a ∈ I` and `s ∉ I(P)` forms of the same degree. For the ideal generated by forms
it is generated by their local equations (`localIdeal_span`). -/
noncomputable def localIdeal (I : Ideal (MvPolynomial (Fin (n + 1)) k)) : Ideal (localRing P) where
  carrier := {z | ∃ c : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k)
    (pointIdeal P).toIdeal.primeCompl, (c.num : MvPolynomial (Fin (n + 1)) k) ∈ I ∧ mk c = z}
  add_mem' := by
    rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    refine ⟨a + b, ?_, mk_add _ a b⟩
    rw [NumDenSameDeg.num_add]
    exact add_mem (I.mul_mem_left _ hb) (I.mul_mem_left _ ha)
  zero_mem' := ⟨0, by simp, mk_zero _⟩
  smul_mem' := by
    rintro z _ ⟨a, ha, rfl⟩
    obtain ⟨c, rfl⟩ := mk_surjective z
    exact ⟨c * a, by rw [NumDenSameDeg.num_mul]; exact I.mul_mem_left _ ha, mk_mul _ c a⟩

variable {I J : Ideal (MvPolynomial (Fin (n + 1)) k)}

/-- An element of `𝒪_P(ℙⁿ)` lies in `localIdeal P I` iff it is a fraction `a / s` of forms of
the same degree with `a ∈ I` and `s(P) ≠ 0`. -/
theorem mem_localIdeal_iff {z : localRing P} :
    z ∈ localIdeal P I ↔ ∃ c : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k)
      (pointIdeal P).toIdeal.primeCompl, (c.num : MvPolynomial (Fin (n + 1)) k) ∈ I ∧ mk c = z :=
  Iff.rfl

/-- A fraction `a / s` with `a ∈ I` lies in `localIdeal P I`. -/
theorem mk_mem_localIdeal
    (c : NumDenSameDeg (homogeneousSubmodule (Fin (n + 1)) k) (pointIdeal P).toIdeal.primeCompl)
    (hc : (c.num : MvPolynomial (Fin (n + 1)) k) ∈ I) : mk c ∈ localIdeal P I :=
  ⟨c, hc, rfl⟩

/-- The local equation of a form in `I` lies in `localIdeal P I`. -/
theorem localEquation_mem_localIdeal (hF : F.IsHomogeneous d) (hFI : F ∈ I) :
    localEquation P F ∈ localIdeal P I := by
  rw [localEquation_eq_mk hF]
  exact mk_mem_localIdeal _ hFI

/-- Localization of ideals is monotone. -/
theorem localIdeal_mono (h : I ≤ J) : localIdeal P I ≤ localIdeal P J := by
  rintro _ ⟨c, hc, rfl⟩
  exact ⟨c, h hc, rfl⟩

variable (P) in
/-- The localized ideal of the unit ideal is the unit ideal. -/
@[simp]
theorem localIdeal_top : localIdeal P (⊤ : Ideal (MvPolynomial (Fin (n + 1)) k)) = ⊤ :=
  (Ideal.eq_top_iff_one _).2 ⟨1, Submodule.mem_top, mk_one _⟩

/-- The localized ideal of `I` lies in the ideal generated by the local equations of the elements
of `I`. -/
theorem localIdeal_le_map : localIdeal P I ≤ I.map (localEquation P) := by
  rintro _ ⟨c, hc, rfl⟩
  obtain ⟨u, hu⟩ := associated_localEquation_mk c
  rw [← hu]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hc)

/-- For a homogeneous ideal `I`, the localized ideal `localIdeal P I` is the ideal generated by
the local equations of the elements of `I`. -/
theorem localIdeal_eq_map (hI : I.IsHomogeneous (homogeneousSubmodule (Fin (n + 1)) k)) :
    localIdeal P I = I.map (localEquation P) := by
  refine le_antisymm localIdeal_le_map (Ideal.map_le_iff_le_comap.2 fun a ha ↦ ?_)
  rw [Ideal.mem_comap, ← sum_homogeneousComponent a, map_sum]
  exact Ideal.sum_mem _ fun j _ ↦ localEquation_mem_localIdeal
    (homogeneousComponent_isHomogeneous j a) (homogeneousComponent_mem_of_mem hI ha j)

/-- **Localized ideals of ideals generated by forms.** If `S` consists of forms, the localized
ideal of the ideal generated by `S` is generated by the local equations of the elements of
`S`. -/
theorem localIdeal_span {S : Set (MvPolynomial (Fin (n + 1)) k)}
    (hS : ∀ F ∈ S, ∃ d, F.IsHomogeneous d) :
    localIdeal P (Ideal.span S) = Ideal.span (localEquation P '' S) := by
  rw [localIdeal_eq_map (Ideal.homogeneous_span _ _ fun F hF ↦ ?_), Ideal.map_span]
  obtain ⟨d, hd⟩ := hS F hF
  exact ⟨d, (mem_homogeneousSubmodule _ _).2 hd⟩

/-- The localized ideal of `(F)`, for a form `F`, is generated by `F_*`. -/
theorem localIdeal_span_singleton (hF : F.IsHomogeneous d) :
    localIdeal P (Ideal.span {F}) = Ideal.span {localEquation P F} := by
  rw [localIdeal_span (by simpa using ⟨d, hF⟩), Set.image_singleton]

/-- **The localized ideal of `(F, G)`.** For forms `F` and `G`, the localized ideal of
`(F, G)` in `𝒪_P(ℙⁿ)` is generated by their local equations `F_*` and `G_*`. -/
theorem localIdeal_span_pair (hF : F.IsHomogeneous d) (hG : G.IsHomogeneous e) :
    localIdeal P (Ideal.span {F, G}) = Ideal.span {localEquation P F, localEquation P G} := by
  rw [localIdeal_span (by simpa using ⟨⟨d, hF⟩, ⟨e, hG⟩⟩), Set.image_pair]

end PlaneCurves.Projective

end
