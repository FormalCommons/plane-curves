module

public import Mathlib.RingTheory.Nullstellensatz

/-!
# The ideal of a point and separating polynomials

The ideal of a point `P ∈ kⁿ` is Mathlib's `MvPolynomial.vanishingIdeal k {P}`. This file
describes it and the algebraic sets around it.

## Main results

* `MvPolynomial.ker_eval`: the kernel of evaluation at `P` is spanned by the `X i - C (P i)`.
* `MvPolynomial.vanishingIdeal_singleton_eq_span`: the ideal of a point `P` is generated by
  the `X i - C (P i)`.
* `MvPolynomial.le_vanishingIdeal_singleton_iff`: an ideal lies in the ideal of a point `x`
  iff `x` lies in its zero locus.
* `MvPolynomial.quotientVanishingIdealSingletonAlgEquiv`: `k[X] ⧸ I(P) ≃ₐ[k] k`.
* `MvPolynomial.exists_eval_eq_indicator`: for finitely many points, there is a polynomial
  that is `1` at one of them and `0` at the others.
* `MvPolynomial.zeroLocus_sup`, `MvPolynomial.zeroLocus_inf`,
  `MvPolynomial.vanishingIdeal_union`: algebraic sets under sums, intersections and unions.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §§1.2–1.3, Problem 1.17
-/

public section

namespace MvPolynomial

open Ideal

section CommRing

variable {R σ : Type*} [CommRing R]

/-- Modulo the ideal spanned by the `X i - C (P i)`, a polynomial is congruent to its value
at `P`. -/
theorem mk_span_X_sub_C_eq_mk_C_eval (P : σ → R) (f : MvPolynomial σ R) :
    Ideal.Quotient.mk (span (Set.range fun i => X i - C (P i))) f =
      Ideal.Quotient.mk _ (C (eval P f)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
    have hi : Ideal.Quotient.mk (span (Set.range fun i => X i - C (P i))) (X i) =
        Ideal.Quotient.mk _ (C (P i)) :=
      Ideal.Quotient.eq.2 (subset_span ⟨i, rfl⟩)
    simp [hp, hi]

/-- The kernel of evaluation at a point `P` is the ideal spanned by the `X i - C (P i)`. -/
theorem ker_eval (P : σ → R) :
    RingHom.ker (eval P) = span (Set.range fun i => X i - C (P i)) := by
  refine le_antisymm (fun f hf => ?_) (span_le.2 ?_)
  · rw [← Ideal.Quotient.eq_zero_iff_mem, mk_span_X_sub_C_eq_mk_C_eval, (RingHom.mem_ker).1 hf,
      C_0, map_zero]
  · rintro _ ⟨i, rfl⟩
    simp

end CommRing

variable {k K σ : Type*} [Field k] [Field K] [Algebra k K]

/-- The ideal of a point `P ∈ kⁿ` is generated by the polynomials `X i - C (P i)`. -/
theorem vanishingIdeal_singleton_eq_span (P : σ → k) :
    vanishingIdeal k {P} = span (Set.range fun i => X i - C (P i)) := by
  rw [← ker_eval]
  ext f
  simp

/-- The ideal of a point `P ∈ Kⁿ`, over an extension `K` of `k`, is the kernel of evaluation
at `P`. -/
theorem vanishingIdeal_singleton_eq_ker (P : σ → K) :
    vanishingIdeal k {P} = RingHom.ker (aeval (R := k) P) := by
  ext f
  simp

/-- An ideal lies in the ideal of a point `x` iff `x` lies in its zero locus. -/
theorem le_vanishingIdeal_singleton_iff {I : Ideal (MvPolynomial σ k)} {x : σ → K} :
    I ≤ vanishingIdeal k {x} ↔ x ∈ zeroLocus K I :=
  le_zeroLocus_iff_le_vanishingIdeal.symm.trans Set.singleton_subset_iff

/-- The quotient of the polynomial ring by the ideal of a point `P ∈ kⁿ` is `k`, by evaluation
at `P`. -/
noncomputable def quotientVanishingIdealSingletonAlgEquiv (P : σ → k) :
    (MvPolynomial σ k ⧸ (vanishingIdeal k {P} : Ideal (MvPolynomial σ k))) ≃ₐ[k] k :=
  (quotientEquivAlgOfEq k (vanishingIdeal_singleton_eq_ker P)).trans
    (quotientKerAlgEquivOfSurjective (f := aeval (R := k) P) fun a => ⟨C a, by simp⟩)

theorem quotientVanishingIdealSingletonAlgEquiv_def (P : σ → k) :
    quotientVanishingIdealSingletonAlgEquiv P =
      (Ideal.quotientEquivAlgOfEq k (vanishingIdeal_singleton_eq_ker P)).trans
        (Ideal.quotientKerAlgEquivOfSurjective (f := aeval (R := k) P) fun a => ⟨C a, by simp⟩) :=
  (rfl)

@[simp]
theorem quotientVanishingIdealSingletonAlgEquiv_mk (P : σ → k) (f : MvPolynomial σ k) :
    quotientVanishingIdealSingletonAlgEquiv P (Ideal.Quotient.mk _ f) = eval P f := by
  simp only [quotientVanishingIdealSingletonAlgEquiv_def, AlgEquiv.trans_apply,
    Ideal.quotientEquivAlgOfEq_mk]
  exact (Ideal.quotientKerAlgEquivOfSurjective_mk _ f).trans (coe_aeval_eq_eval P ▸ rfl)

@[simp]
theorem quotientVanishingIdealSingletonAlgEquiv_symm_apply (P : σ → k) (a : k) :
    (quotientVanishingIdealSingletonAlgEquiv P).symm a = Ideal.Quotient.mk _ (C a) := by
  rw [AlgEquiv.symm_apply_eq]
  simp

/-- **Separating polynomials.** Given finitely many points `S` of `kⁿ` and a point `P ∈ S`,
there is a polynomial whose value is `1` at `P` and `0` at the other points of `S`. -/
theorem exists_eval_eq_indicator [DecidableEq (σ → k)] (S : Finset (σ → k)) (P : σ → k) :
    ∃ f : MvPolynomial σ k, ∀ Q ∈ S, eval Q f = if Q = P then 1 else 0 := by
  classical
  have h (Q : σ → k) (hQ : Q ≠ P) : ∃ g : MvPolynomial σ k, eval P g = 1 ∧ eval Q g = 0 := by
    obtain ⟨i, hi⟩ := Function.ne_iff.1 hQ
    refine ⟨C (P i - Q i)⁻¹ * (X i - C (Q i)), ?_, by simp⟩
    simp [inv_mul_cancel₀ (sub_ne_zero.2 (Ne.symm hi))]
  choose! g hg using h
  refine ⟨∏ Q ∈ S.erase P, g Q, fun Q hQ => ?_⟩
  split_ifs with hQP
  · subst hQP
    simp only [map_prod]
    exact Finset.prod_eq_one fun R hR => (hg R (Finset.ne_of_mem_erase hR)).1
  · simp only [map_prod]
    exact Finset.prod_eq_zero (Finset.mem_erase.2 ⟨hQP, hQ⟩) (hg Q hQP).2

/-- The zero locus of a sum of ideals is the intersection of their zero loci. -/
theorem zeroLocus_sup (I J : Ideal (MvPolynomial σ k)) :
    zeroLocus K (I ⊔ J) = zeroLocus K I ∩ zeroLocus K J :=
  (zeroLocus_vanishingIdeal_galoisConnection (k := k) (K := K) (σ := σ)).l_sup

/-- The zero locus of an intersection of ideals is the union of their zero loci. -/
theorem zeroLocus_inf (I J : Ideal (MvPolynomial σ k)) :
    zeroLocus K (I ⊓ J) = zeroLocus K I ∪ zeroLocus K J := by
  refine le_antisymm (fun x hx => ?_)
    (Set.union_subset (zeroLocus_anti_mono inf_le_left) (zeroLocus_anti_mono inf_le_right))
  by_contra h
  simp only [Set.mem_union, mem_zeroLocus_iff, not_or, not_forall] at h
  obtain ⟨⟨f, hf, hfx⟩, ⟨g, hg, hgx⟩⟩ := h
  exact mul_ne_zero hfx hgx <| by
    simpa using (mem_zeroLocus_iff.1 hx) (f * g) ⟨I.mul_mem_right g hf, J.mul_mem_left f hg⟩

/-- The ideal of a union of sets is the intersection of their ideals. -/
theorem vanishingIdeal_union (A B : Set (σ → K)) :
    vanishingIdeal k (A ∪ B) = vanishingIdeal k A ⊓ vanishingIdeal k B :=
  (zeroLocus_vanishingIdeal_galoisConnection (k := k) (K := K) (σ := σ)).u_inf

end MvPolynomial

end
