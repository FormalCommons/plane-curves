/-!
# The quotient of a polynomial ring by two coprime polynomials

Let `k` be a field and `R = k[X_i : i ∈ σ]`. This file proves the two algebraic facts about
`Γ = R/(F, G)` on which Fulton's proof of Bézout's theorem rests (Fulton, §5.3).

* **Step 1.** If `F` and `G` are coprime forms of degrees `m` and `n` in `k[X, Y, Z]`, then
  `dim_k Γ_d = mn` for every `d ≥ m + n - 2`. Coprimality makes `F, G` a regular sequence, which
  is what makes Fulton's sequence `0 → R_{d-m-n} → R_{d-m} × R_{d-n} → R_d → Γ_d → 0` exact; the
  dimension count is Tau Ceti's Hilbert series of a quotient by a homogeneous regular sequence,
  `H_Γ(t) = H_R(t) (1 - t^m) (1 - t^n)`.
* **Step 2.** If `F` and `G` become coprime when the variable `X i` is set to zero, then
  multiplication by `X i` is injective on `Γ`: `X i * H ∈ (F, G)` implies `H ∈ (F, G)`. Neither
  homogeneity nor finiteness of `σ` is needed.

## Main results

* `IsRelPrime.exists_eq_mul_of_mul_add_mul_eq_zero`: if `a` and `b` are coprime, every relation
  `x a + y b = 0` is a multiple of the trivial one, `x = b c` and `y = -(a c)`.
* `IsRelPrime.isWeaklyRegular`: two coprime elements of a factorial domain, the first nonzero,
  form a weakly regular sequence.
* `MvPolynomial.finrank_quotientPiece_span_pair_fin_three`: Step 1.
* `MvPolynomial.X_mul_mem_span_pair_iff`: Step 2.

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §5.3
-/

public section

open TauCeti.GradedAlgebra

/-- In a domain where every element is primal, for example a unique factorization domain, the
relations between two coprime elements are generated by the trivial one: if `x a + y b = 0`, then
`x = b c` and `y = -(a c)` for some `c`. -/
theorem IsRelPrime.exists_eq_mul_of_mul_add_mul_eq_zero {R : Type*} [CommRing R] [IsDomain R]
    [DecompositionMonoid R] {a b x y : R} (h : IsRelPrime a b) (hxy : x * a + y * b = 0) :
    ∃ c, x = b * c ∧ y = -(a * c) := by
  by_cases ha : a = 0
  · subst ha
    obtain ⟨u, rfl⟩ := (isRelPrime_zero_left.mp h)
    refine ⟨x * ↑u⁻¹, by simp [mul_left_comm], ?_⟩
    simpa using hxy
  · obtain ⟨c, rfl⟩ := h.dvd_of_dvd_mul_right (y := y) ⟨-x, by linear_combination hxy⟩
    refine ⟨-c, ?_, by ring⟩
    have : a * (x + b * c) = 0 := by linear_combination hxy
    linear_combination (mul_eq_zero.mp this).resolve_left ha

/-- In a domain where every element is primal, for example a unique factorization domain, two
coprime elements `a, b` with `a ≠ 0` form a weakly regular sequence: `a` is a non-zero-divisor
and `b` is a non-zero-divisor modulo `a`. -/
theorem IsRelPrime.isWeaklyRegular {R : Type*} [CommRing R] [IsDomain R] [DecompositionMonoid R]
    {a b : R} (h : IsRelPrime a b) (ha : a ≠ 0) : RingTheory.Sequence.IsWeaklyRegular R [a, b] := by
  refine RingTheory.Sequence.IsWeaklyRegular.cons (IsSMulRegular.of_ne_zero ha) ?_
  refine (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).mpr ?_
  refine TauCeti.isSMulRegular_quotSMulTop_iff.mpr fun x c hc ↦ ?_
  obtain ⟨d, rfl⟩ := h.dvd_of_dvd_mul_left (z := x) ⟨c, by simpa [eq_comm] using hc⟩
  exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top

namespace MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {σ k : Type*} [Field k]

/-- Twice the number of monomials of degree `d - j` in three variables, read as `0` when
`d < j`, is `(d - j + 2)(d - j + 1)` whenever `j ≤ d + 2`. -/
private theorem two_mul_ite_multichoose_three {d j : ℕ} (hj : j ≤ d + 2) :
    2 * (if j ≤ d then ((3 : ℕ).multichoose (d - j) : ℤ) else 0) =
      ((d : ℤ) - j + 2) * ((d : ℤ) - j + 1) := by
  split_ifs with h
  · obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_le h
    have h₂ : 2 * (3 : ℕ).multichoose e = (e + 2) * (e + 1) := by
      clear hj h
      induction e with
      | zero => simp
      | succ e ih =>
        rw [Nat.multichoose_succ_succ, Nat.multichoose_two, mul_add, ih]
        ring
    rw [Nat.add_sub_cancel_left]
    have := congrArg (fun x : ℕ ↦ (x : ℤ)) h₂
    push_cast at this ⊢
    linear_combination this
  · obtain ⟨i, hi, rfl⟩ : ∃ i : ℕ, i < 2 ∧ j = d + 1 + i := ⟨j - d - 1, by omega, by omega⟩
    interval_cases i <;> push_cast <;> ring

/-- Step 1 for a nonzero first form. -/
private theorem finrank_quotientPiece_span_pair_fin_three_of_ne_zero
    {F G : MvPolynomial (Fin 3) k} {m n d : ℕ}
    (hF : F.IsHomogeneous m) (hG : G.IsHomogeneous n) (hF₀ : F ≠ 0) (hFG : IsRelPrime F G)
    (hd : m + n ≤ d + 2) :
    Module.finrank k (quotientPiece (homogeneousSubmodule (Fin 3) k) (Ideal.span {F, G}) d) =
      m * n := by
  have h := mk_finrank_quotientPiece_of_isWeaklyRegular (S := ℤ) (homogeneousSubmodule (Fin 3) k)
    [(F, m), (G, n)] (by simpa [mem_homogeneousSubmodule] using ⟨hF, hG⟩)
    (by simpa using hFG.isWeaklyRegular hF₀)
  have hspan : Ideal.ofList ([(F, m), (G, n)].map Prod.fst) = Ideal.span {F, G} := by
    simp only [List.map_cons, List.map_nil, Ideal.ofList, List.mem_cons, List.not_mem_nil,
      or_false]
    rfl
  rw [hspan] at h
  have hc := congrArg (PowerSeries.coeff d) h
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
    PowerSeries.coeff_mk] at hc
  have hexp : ∀ p : PowerSeries ℤ, p * ((1 - PowerSeries.X ^ m) * (1 - PowerSeries.X ^ n)) =
      p - p * PowerSeries.X ^ m - p * PowerSeries.X ^ n + p * PowerSeries.X ^ (m + n) := by
    intro p
    ring
  rw [hexp] at hc
  simp only [map_add, map_sub, PowerSeries.coeff_mul_X_pow', PowerSeries.coeff_mk,
    TauCeti.finrank_homogeneousSubmodule_eq_multichoose, Fintype.card_fin] at hc
  have h₀ := two_mul_ite_multichoose_three (d := d) (j := 0) (by omega)
  have h₁ := two_mul_ite_multichoose_three (d := d) (j := m) (by omega)
  have h₂ := two_mul_ite_multichoose_three (d := d) (j := n) (by omega)
  have h₃ := two_mul_ite_multichoose_three (d := d) (j := m + n) (by omega)
  simp only [zero_le, ite_true, Nat.sub_zero] at h₀
  have : (Module.finrank k (quotientPiece (homogeneousSubmodule (Fin 3) k)
      (Ideal.span {F, G}) d) : ℤ) = m * n := by
    refine mul_left_cancel₀ (two_ne_zero (α := ℤ)) ?_
    push_cast at h₀ h₃
    linear_combination 2 * hc + h₀ - h₁ - h₂ + h₃
  exact_mod_cast this

/-- **Step 1 of Fulton's proof of Bézout's theorem.** If `F` and `G` are coprime forms of degrees
`m` and `n` in `k[X, Y, Z]`, then the degree-`d` piece of `k[X, Y, Z]/(F, G)` has dimension `mn`
for every `d ≥ m + n - 2`. -/
theorem finrank_quotientPiece_span_pair_fin_three {F G : MvPolynomial (Fin 3) k} {m n d : ℕ}
    (hF : F.IsHomogeneous m) (hG : G.IsHomogeneous n) (hFG : IsRelPrime F G)
    (hd : m + n ≤ d + 2) :
    Module.finrank k (quotientPiece (homogeneousSubmodule (Fin 3) k) (Ideal.span {F, G}) d) =
      m * n := by
  rcases eq_or_ne F 0 with rfl | hF₀
  · have hG₀ : G ≠ 0 := by
      rintro rfl
      exact not_isUnit_zero (isRelPrime_zero_left.mp hFG)
    rw [Set.pair_comm, mul_comm]
    exact finrank_quotientPiece_span_pair_fin_three_of_ne_zero hG hF hG₀ hFG.symm (by omega)
  · exact finrank_quotientPiece_span_pair_fin_three_of_ne_zero hF hG hF₀ hFG hd

section SetVarZero

variable {R : Type*} [CommRing R] [DecidableEq σ]

/-- Setting the variable `X i` to zero twice is setting it to zero once. -/
@[simp]
theorem bind₁_update_X_zero_bind₁_update_X_zero (i : σ) (p : MvPolynomial σ R) :
    bind₁ (Function.update X i 0) (bind₁ (Function.update X i 0) p) =
      bind₁ (Function.update X i (0 : MvPolynomial σ R)) p := by
  rw [← AlgHom.comp_apply]
  congr 1
  refine algHom_ext fun j ↦ ?_
  rcases eq_or_ne j i with rfl | hj <;> simp [*]

/-- A polynomial and its value at `X i = 0` agree modulo `X i`. -/
theorem X_dvd_sub_bind₁_update_X_zero (i : σ) (p : MvPolynomial σ R) :
    X i ∣ p - bind₁ (Function.update X i 0) p := by
  rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
  change Ideal.Quotient.mkₐ R _ p = Ideal.Quotient.mkₐ R _ (bind₁ _ p)
  rw [← AlgHom.comp_apply]
  congr 1
  refine algHom_ext fun j ↦ ?_
  rcases eq_or_ne j i with rfl | hj
  · simp
  · simp [hj]

/-- A polynomial whose value at `X i = 0` vanishes is divisible by `X i`. -/
theorem X_dvd_of_bind₁_update_X_zero_eq_zero {i : σ} {p : MvPolynomial σ R}
    (hp : bind₁ (Function.update X i 0) p = 0) : X i ∣ p := by
  simpa [hp] using X_dvd_sub_bind₁_update_X_zero i p

end SetVarZero

/-- **Step 2 of Fulton's proof of Bézout's theorem.** If the polynomials `F` and `G` stay coprime
when the variable `X i` is set to zero, then multiplication by `X i` is injective on
`k[X]/(F, G)`: `X i * H ∈ (F, G)` if and only if `H ∈ (F, G)`. For forms `F`, `G` in
`k[X, Y, Z]` and `X i = Z` the hypothesis says that `F(X, Y, 0)` and `G(X, Y, 0)` are coprime. -/
theorem X_mul_mem_span_pair_iff [DecidableEq σ] {i : σ} {F G H : MvPolynomial σ k}
    (hFG : IsRelPrime (bind₁ (Function.update X i 0) F) (bind₁ (Function.update X i 0) G)) :
    X i * H ∈ Ideal.span {F, G} ↔ H ∈ Ideal.span {F, G} := by
  refine ⟨fun h ↦ ?_, fun h ↦ Ideal.mul_mem_left _ _ h⟩
  set φ := bind₁ (Function.update X i (0 : MvPolynomial σ k))
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp h
  have hφ : φ a * φ F + φ b * φ G = 0 := by
    simpa [φ] using congrArg φ hab
  obtain ⟨c, hac, hbc⟩ := hFG.exists_eq_mul_of_mul_add_mul_eq_zero hφ
  have hac' : φ a = φ G * φ c := by
    simpa [φ] using congrArg φ hac
  have hbc' : φ b = -(φ F * φ c) := by
    simpa [φ] using congrArg φ hbc
  have hφφ (p : MvPolynomial σ k) : φ (φ p) = φ p := bind₁_update_X_zero_bind₁_update_X_zero i p
  obtain ⟨a', ha'⟩ : X i ∣ a - φ c * G := X_dvd_of_bind₁_update_X_zero_eq_zero <| by
    change φ _ = 0
    rw [map_sub, map_mul, hφφ, hac']
    ring
  obtain ⟨b', hb'⟩ : X i ∣ b + φ c * F := X_dvd_of_bind₁_update_X_zero_eq_zero <| by
    change φ _ = 0
    rw [map_add, map_mul, hφφ, hbc']
    ring
  have hH : X i * H = X i * (a' * F + b' * G) := by
    rw [← hab]
    linear_combination F * ha' + G * hb'
  rw [mul_left_cancel₀ (X_ne_zero i) hH]
  exact Ideal.mem_span_pair.mpr ⟨a', b', rfl⟩

end MvPolynomial

end
