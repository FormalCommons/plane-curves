module

public import PlaneCurves.RingTheory.MvPolynomial.Homogenize.Factorization
public import TauCeti.RingTheory.MvPolynomial.Homogenization
public import Mathlib.RingTheory.GradedAlgebra.Radical

/-!
# Homogenization of ideals

For an ideal `J` of `R[Y₀, …, Yₙ₋₁]` and a coordinate `i : Fin (n + 1)`, Tau Ceti's
`Ideal.homogenization J i` is the largest homogeneous ideal of `R[X₀, …, Xₙ]` whose
dehomogenization at `Xᵢ = 1` lies in `J`. This file shows that it is Fulton's `J*`, the ideal
generated by the homogenizations `f* = MvPolynomial.homogenize i f.totalDegree f` of the elements
`f ∈ J`, that it is prime when `J` is, and that the homogenization of a principal ideal `(F)` is
`(F*)` over a ring without zero divisors.

The other statements of Fulton's part (a) are in Tau Ceti: a form `G` lies in `J*` iff `G_* ∈ J`
(`Ideal.mem_homogenization_iff_of_isHomogeneous`), `(J*)_* = J`
(`Ideal.map_dehomogenize_homogenization`) and `Xᵢ G ∈ J*` implies `G ∈ J*`
(`Ideal.X_mul_mem_homogenization_iff`).

## Main results

* `Ideal.homogenization_eq_span_homogenize`: `J*` is spanned by the `f*`, `f ∈ J`.
* `Ideal.IsPrime.homogenization`: if `J` is prime, so is `J*`.
* `Ideal.homogenization_span_singleton`: `(F)* = (F*)` (Fulton's Problem 4.19).

An example after them shows, for the twisted cubic, that generators of `J` need not homogenize
to generators of `J*` (Fulton's Problem 4.20).

## References

* [W. Fulton, *Algebraic Curves*][Fulton2008], §4.3, Problems 4.19 and 4.20
-/

public section

open MvPolynomial TauCeti

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Ideal

variable {R : Type*} [CommRing R] {n : ℕ} {i : Fin (n + 1)}

/-- The homogenization `f* = homogenize i f.totalDegree f` of an element `f` of `J` lies in the
homogenization of `J`. -/
theorem homogenize_mem_homogenization {J : Ideal (MvPolynomial (Fin n) R)}
    {f : MvPolynomial (Fin n) R} (hf : f ∈ J) :
    homogenize i f.totalDegree f ∈ J.homogenization i :=
  (mem_homogenization_iff_of_isHomogeneous (isHomogeneous_homogenize i _ f)).mpr (by simpa)

/-- The homogenization of an ideal `J` is Fulton's `J*`: the ideal generated by the
homogenizations `f* = homogenize i f.totalDegree f` of the elements `f ∈ J`. -/
theorem homogenization_eq_span_homogenize (J : Ideal (MvPolynomial (Fin n) R))
    (i : Fin (n + 1)) :
    (J.homogenization i).toIdeal =
      span ((fun f ↦ homogenize i f.totalDegree f) '' (J : Set (MvPolynomial (Fin n) R))) := by
  refine le_antisymm (fun q hq ↦ ?_)
    (span_le.mpr (Set.image_subset_iff.mpr fun f hf ↦ homogenize_mem_homogenization hf))
  rw [← sum_homogeneousComponent q]
  refine _root_.sum_mem fun d _ ↦ ?_
  -- A form `G` of degree `d` with `G_* ∈ J` is `X i ^ r * (G_*)*`.
  rw [← X_pow_mul_homogenize_dehomogenize (i := i) (homogeneousComponent_isHomogeneous d q)]
  exact mul_mem_left _ _ (subset_span ⟨_, mem_homogenization_iff.mp hq d, rfl⟩)

/-- The homogenization of a prime ideal is prime. -/
theorem IsPrime.homogenization {J : Ideal (MvPolynomial (Fin n) R)} (hJ : J.IsPrime) :
    (J.homogenization i).toIdeal.IsPrime := by
  refine (J.homogenization i).isHomogeneous.isPrime_of_homogeneous_mem_or_mem
    (fun h ↦ hJ.ne_top ((eq_top_iff_one J).mpr ?_)) fun {x y} ⟨a, hx⟩ ⟨b, hy⟩ hxy ↦ ?_
  · simpa using dehomogenize_mem_of_mem_homogenization (J := J) (i := i) (q := 1)
      (by rw [← HomogeneousIdeal.mem_iff, h]; exact Submodule.mem_top)
  · have hx' : x.IsHomogeneous a := hx
    have hy' : y.IsHomogeneous b := hy
    rw [HomogeneousIdeal.mem_iff, mem_homogenization_iff_of_isHomogeneous (hx'.mul hy'),
      map_mul] at hxy
    simpa only [HomogeneousIdeal.mem_iff, mem_homogenization_iff_of_isHomogeneous hx',
      mem_homogenization_iff_of_isHomogeneous hy'] using hJ.mem_or_mem hxy

/-- Fulton's Problem 4.19, `(F)* = (F*)`: over a ring without zero divisors, the homogenization of
the principal ideal of `F` is the principal ideal of `F* = homogenize i F.totalDegree F`. -/
theorem homogenization_span_singleton [NoZeroDivisors R] (F : MvPolynomial (Fin n) R)
    (i : Fin (n + 1)) :
    ((span {F}).homogenization i).toIdeal = span {homogenize i F.totalDegree F} := by
  refine le_antisymm ?_ (span_le.mpr (Set.singleton_subset_iff.mpr
    (homogenize_mem_homogenization (mem_span_singleton_self F))))
  rw [homogenization_eq_span_homogenize, span_le]
  rintro _ ⟨f, hf, rfl⟩
  obtain ⟨g, rfl⟩ := mem_span_singleton'.mp hf
  change homogenize i (g * F).totalDegree (g * F) ∈ _
  rw [homogenize_totalDegree_mul]
  exact mul_mem_left _ _ (mem_span_singleton_self _)

/-- Fulton's Problem 4.20: generators of `J` need not homogenize to generators of `J*`. For the
twisted cubic `J = (Y - X², Z - X³)` in `R[X, Y, Z]`, homogenized in the new last variable `W`,
the form `ZW - XY` lies in `J*` but not in `((Y - X²)*, (Z - X³)*) = (YW - X², ZW² - X³)`. -/
example [Nontrivial R] :
    (X 2 * X 3 - X 0 * X 1 : MvPolynomial (Fin 4) R) ∈
      (span {X 1 - X 0 ^ 2, X 2 - X 0 ^ 3}).homogenization 3 ∧
    (X 2 * X 3 - X 0 * X 1 : MvPolynomial (Fin 4) R) ∉ span
      {homogenize 3 (X 1 - X 0 ^ 2 : MvPolynomial (Fin 3) R).totalDegree (X 1 - X 0 ^ 2),
        homogenize 3 (X 2 - X 0 ^ 3 : MvPolynomial (Fin 3) R).totalDegree (X 2 - X 0 ^ 3)} := by
  have hdeg {m : ℕ} (hm : 1 < m) (j k : Fin 3) :
      (X j - X k ^ m : MvPolynomial (Fin 3) R).totalDegree = m := by
    rw [sub_eq_add_neg, totalDegree_add_eq_right_of_totalDegree_lt] <;>
      simp [totalDegree_neg, totalDegree_X_pow, totalDegree_X, hm]
  have hG : (X 2 * X 3 - X 0 * X 1 : MvPolynomial (Fin 4) R).IsHomogeneous 2 :=
    ((isHomogeneous_X R _).mul (isHomogeneous_X R _)).sub
      ((isHomogeneous_X R _).mul (isHomogeneous_X R _))
  have hG₁ : (X 1 * X 3 - X 0 ^ 2 : MvPolynomial (Fin 4) R).IsHomogeneous 2 :=
    ((isHomogeneous_X R _).mul (isHomogeneous_X R _)).sub (isHomogeneous_X_pow _ 2)
  rw [hdeg one_lt_two, hdeg (by norm_num : 1 < 3)]
  refine ⟨(mem_homogenization_iff_of_isHomogeneous hG).mpr ?_, fun h ↦ ?_⟩
  · -- `Z - XY = (Z - X³) - X (Y - X²)`.
    have : dehomogenize 3 (X 2 * X 3 - X 0 * X 1 : MvPolynomial (Fin 4) R) =
        (X 2 - X 0 ^ 3) - X 0 * (X 1 - X 0 ^ 2) := by
      simp only [map_sub, map_mul, dehomogenize_X]
      change X 2 * 1 - X 0 * X 1 = _
      ring
    rw [this]
    exact sub_mem (subset_span (by simp)) (mul_mem_left _ _ (subset_span (by simp)))
  -- The component of degree two of `a (YW - X²) + b (ZW² - X³)` is `c (YW - X²)`, `c` a constant,
  -- which vanishes at `(X, Y, Z, W) = (0, 0, 1, 1)`, where `ZW - XY` does not.
  have h₁ : homogenize (3 : Fin 4) 2 (X 1 - X 0 ^ 2 : MvPolynomial (Fin 3) R) =
      X 1 * X 3 - X 0 ^ 2 := by
    refine (eq_homogenize_of_isHomogeneous hG₁ ?_).symm
    simp only [map_sub, map_mul, map_pow, dehomogenize_X]
    change X 1 * 1 - X 0 ^ 2 = _
    rw [mul_one]
  obtain ⟨a, b, hab⟩ := mem_span_pair.mp h
  have := congrArg (homogeneousComponent 2) hab
  rw [map_add, (isHomogeneous_homogenize _ 3 _).homogeneousComponent_mul_right, h₁,
    hG₁.homogeneousComponent_mul_right, homogeneousComponent_of_mem hG] at this
  simpa using congrArg (eval ![0, 0, 1, 1]) this

end Ideal

end
