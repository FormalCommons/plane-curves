module

public import Mathlib.RingTheory.Ideal.Maps

/-!
# Ideals generated by two elements under ring isomorphisms

A ring isomorphism `φ : R ≃+* S` carrying `a` and `b` to associates of `a'` and `b'` maps the
ideal `(a, b)` onto `(a', b')`, and so identifies membership in the two ideals.

## Main results

* `Ideal.map_span_pair_eq_of_associated`: `φ(a, b) = (a', b')`.
* `Ideal.mem_span_pair_iff_of_ringEquiv`: if moreover `φ c` is associated to `c'`, then
  `c' ∈ (a', b') ↔ c ∈ (a, b)`.
-/

public section

/-- A ring isomorphism carrying `a` and `b` to associates of `a'` and `b'` maps `(a, b)` onto
`(a', b')`. -/
theorem Ideal.map_span_pair_eq_of_associated {R S : Type*} [CommSemiring R] [CommSemiring S]
    (φ : R ≃+* S) {a b : R} {a' b' : S} (ha : Associated (φ a) a')
    (hb : Associated (φ b) b') :
    (Ideal.span {a, b}).map φ = Ideal.span {a', b'} := by
  obtain ⟨u, rfl⟩ := ha
  obtain ⟨v, rfl⟩ := hb
  rw [Ideal.span_insert (_ * _), Ideal.span_singleton_mul_right_unit u.isUnit,
    Ideal.span_singleton_mul_right_unit v.isUnit, ← Ideal.span_insert, Ideal.map_span,
    Set.image_pair]

/-- A ring isomorphism carrying `a`, `b`, `c` to associates of `a'`, `b'`, `c'` identifies
`c ∈ (a, b)` with `c' ∈ (a', b')`. -/
theorem Ideal.mem_span_pair_iff_of_ringEquiv {R S : Type*} [CommSemiring R] [CommSemiring S]
    (φ : R ≃+* S) {a b c : R} {a' b' c' : S} (ha : Associated (φ a) a')
    (hb : Associated (φ b) b') (hc : Associated (φ c) c') :
    c' ∈ Ideal.span {a', b'} ↔ c ∈ Ideal.span {a, b} := by
  rw [← Ideal.mem_iff_of_associated hc, ← Ideal.map_span_pair_eq_of_associated φ ha hb,
    Ideal.apply_mem_of_equiv_iff]

end
